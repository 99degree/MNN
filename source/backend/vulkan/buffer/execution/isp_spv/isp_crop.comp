#version 450
#extension GL_EXT_scalar_block_layout : require
// isp.crop — planar single-channel RAW crop (stride-pad removal).
// Input:  [1,1,H_src,W_src] float raw plane (host promoted u16->f32).
// Output: [1,1,cropH,cropW] float — the leading cropW columns, full height.
// Bindings: 0 = uniforms {W_src,H_src,cropW,cropH,startW,startH} (W/H are the
//           hot-swapped source dims); 1 = input plane; 2 = output plane.
// NOTE: the previous shader indexed (y*w + x) * 3 (3-channel packed) and cut
// two of every three pixels out of the raw plane.
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) buffer Uniforms {
    float width;
    float height;
    float cropW;
    float cropH;
    float startW;
    float startH;
};

layout(set = 0, binding = 1, std430) readonly buffer InBuf {
    float in_data[];
};

layout(set = 0, binding = 2, std430) writeonly buffer OutBuf {
    float out_data[];
};

void main() {
    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;

    int w = int(width);
    int h = int(height);
    int ow = int(cropW);
    int oh = int(cropH);
    if (ow <= 0) ow = w;   // <=0 = full source width
    if (oh <= 0) oh = h;   // <=0 = full source height (horizontal-pad crop)

    if (int(x) >= ow || int(y) >= oh) return;

    int sx = int(startW) + int(x);
    int sy = int(startH) + int(y);
    int oidx = int(y) * ow + int(x);

    if (sx >= 0 && sx < w && sy >= 0 && sy < h) {
        out_data[oidx] = in_data[sy * w + sx];
    } else {
        out_data[oidx] = 0.0;
    }
}
