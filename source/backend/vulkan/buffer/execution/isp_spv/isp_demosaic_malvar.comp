#version 450
// isp.demosaic_malvar — 5×5 Malvar demosaic on GPU.
//
// Input:  float[1,4,H,W] NCHW PLANAR quad channels [TL,TR,BL,BR] from CfaBlock.
// Output: float[1,3,H,W] NCHW PLANAR RGB planes.
//
// Bindings follow the universal isp.* positional map:
//   binding 0 = {W,H,pad,pad} (zeroed const attr, hotSwap W/H at first encode)
//   binding 1 = input frame  [1,4,H,W]  (4 quad planes)
//   binding 2 = output frame [1,3,H,W]  (3 RGB planes)
//   binding 3 = DEMOSAIC_MALVAR_WEIGHTS float[60] = [3,4,5,5] Malvar kernels
//       (outCh x inCh x kh x kw), weights already ÷1024.
//   binding 4 = DEMOSAIC_MALVAR_HW float[4]   {W,H,pad,pad} runtime HW input
//   binding 5 = DEMOSAIC_BAYER_PATTERN float[1] 0=RGGB,1=GRBG,2=GBRG,3=BGGR
//
// The 5×5 kernel for each (outCh, inCh) pair is convolved over the corresponding
// input plane and summed across 4 inCh channels, producing one RGB plane.
//
// Bayer pattern rotation: The Malvar weights are defined for RGGB (pattern 0).
// For other patterns, the shader rotates the input channels so that the effective
// pattern seen by the kernels is RGGB:
//   RGGB (0):  inCh order [TL,TR,BL,BR]  → kernels as-is
//   GRBG (1):  rotate so effective TL=TR → inCh[0]=TR,inCh[1]=TL,inCh[2]=BR,inCh[3]=BL
//   GBRG (2):  rotate so effective TL=BL → inCh[0]=BL,inCh[1]=BR,inCh[2]=TL,inCh[3]=TR
//   BGGR (3):  rotate so effective TL=BR → inCh[0]=BR,inCh[1]=BL,inCh[2]=TR,inCh[3]=TL
//
// LAYOUT CONTRACT (2026-10-16): planar NCHW throughout. Matches isp.ccm,
// isp.downscale, isp.gamma planar layout.

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) buffer Uniforms {
    float width;
    float height;
    float pad0;
    float pad1;
} u;

layout(set = 0, binding = 1) readonly  buffer InBuf  { float in_data[]; };
layout(set = 0, binding = 2) writeonly buffer OutBuf { float out_data[]; };
layout(set = 0, binding = 3) readonly  buffer WeightsBuf { float malvar_w[]; };  // [3,4,5,5]
layout(set = 0, binding = 4) readonly  buffer DemosaicHwBuf { float demosaicHw[]; };
layout(set = 0, binding = 5) readonly  buffer BayerPatternBuf { float bayerPattern[]; };

void main() {
    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;
    int w = int(u.width);
    int h = int(u.height);
    if (int(x) >= w || int(y) >= h) return;

    int plane = w * h;           // per-plane stride for 4 inCh and 3 outCh
    int idx = int(y) * w + int(x);

    // Read runtime HW (should match u.width/u.height, but use binding 4 as
    // authoritative so the controller can resize per frame).
    int rw = int(demosaicHw[0]);
    int rh = int(demosaicHw[1]);
    if (rw > 0) w = rw;
    if (rh > 0) h = rh;
    plane = w * h;
    idx = int(y) * w + int(x);
    if (int(x) >= w || int(y) >= h) return;

    // Bayer pattern: 0=RGGB, 1=GRBG, 2=GBRG, 3=BGGR
    int pat = int(bayerPattern[0]);
    if (pat < 0) pat = 0;
    if (pat > 3) pat = 3;

    // Read the 4 input planes
    float i0 = in_data[0 * plane + idx];  // TL
    float i1 = in_data[1 * plane + idx];  // TR
    float i2 = in_data[2 * plane + idx];  // BL
    float i3 = in_data[3 * plane + idx];  // BR

    // Rotate channels so effective pattern is RGGB for the Malvar kernels:
    //   pat 0 (RGGB):  e0=TL,e1=TR,e2=BL,e3=BR  → [i0,i1,i2,i3]
    //   pat 1 (GRBG):  e0=TR,e1=TL,e2=BR,e3=BL  → [i1,i0,i3,i2]
    //   pat 2 (GBRG):  e0=BL,e1=BR,e2=TL,e3=TR  → [i2,i3,i0,i1]
    //   pat 3 (BGGR):  e0=BR,e1=BL,e2=TR,e3=TL  → [i3,i2,i1,i0]
    float e0, e1, e2, e3;
    if (pat == 0) { e0=i0; e1=i1; e2=i2; e3=i3; }
    else if (pat == 1) { e0=i1; e1=i0; e2=i3; e3=i2; }
    else if (pat == 2) { e0=i2; e1=i3; e2=i0; e3=i1; }
    else { e0=i3; e1=i2; e2=i1; e3=i0; }

    // 5×5 convolution: kh, kw ∈ [0,5), center at (2,2)
    // w index: ((outCh * 4 + inCh) * 5 + kh) * 5 + kw
    float r = 0.0, g = 0.0, b = 0.0;
    for (int kh = 0; kh < 5; kh++) {
        int oy = int(y) + kh - 2;
        if (oy < 0 || oy >= h) continue;
        for (int kw = 0; kw < 5; kw++) {
            int ox = int(x) + kw - 2;
            if (ox < 0 || ox >= w) continue;
            int iidx = oy * w + ox;

            float t0 = in_data[0 * plane + iidx];
            float t1 = in_data[1 * plane + iidx];
            float t2 = in_data[2 * plane + iidx];
            float t3 = in_data[3 * plane + iidx];

            // Apply the same pattern rotation to neighbor samples
            float n0, n1, n2, n3;
            if (pat == 0) { n0=t0; n1=t1; n2=t2; n3=t3; }
            else if (pat == 1) { n0=t1; n1=t0; n2=t3; n3=t2; }
            else if (pat == 2) { n0=t2; n1=t3; n2=t0; n3=t1; }
            else { n0=t3; n1=t2; n2=t1; n3=t0; }

            for (int inCh = 0; inCh < 4; inCh++) {
                float tin = (inCh == 0) ? n0 : (inCh == 1) ? n1 : (inCh == 2) ? n2 : n3;
                float wr = malvar_w[((0 * 4 + inCh) * 5 + kh) * 5 + kw];
                float wg = malvar_w[((1 * 4 + inCh) * 5 + kh) * 5 + kw];
                float wb = malvar_w[((2 * 4 + inCh) * 5 + kh) * 5 + kw];
                r += tin * wr;
                g += tin * wg;
                b += tin * wb;
            }
        }
    }

    out_data[0 * plane + idx] = r;
    out_data[1 * plane + idx] = g;
    out_data[2 * plane + idx] = b;
}
