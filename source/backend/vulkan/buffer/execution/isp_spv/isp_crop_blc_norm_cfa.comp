#version 450
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;
layout(set = 0, binding = 0, std430) buffer Uniforms {
    float width;          // input stride width (W_src)
    float height;         // input height (H_src)
    float sensorMax;      // sensor max value (e.g., 1023) for normalization
    float pad;            // unused
} u;
layout(set = 0, binding = 1) readonly  buffer InBuf  { uint in_data[]; };   // raw sensor plane [H_src * W_src], INT16 packed as uint32
layout(set = 0, binding = 2) readonly  buffer BlcBuf { float blc_data[]; };  // per-channel BLC [1,4,1,1] = {blc_R, blc_Gr, blc_Gb, blc_B}, in sensor units
layout(set = 0, binding = 3) writeonly buffer OutBuf { float out_data[]; };   // output [4 * H_dst * W_dst] where H_dst = H_src/2, W_dst = W_src/2

void main() {
    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;
    int w = int(u.width);
    int h = int(u.height);
    // Output dimensions: half of input (due to CFA unpack)
    int outW = w / 2;
    int outH = h / 2;
    if (int(x) >= outW || int(y) >= outH) return;

    // Input coordinates of the top-left pixel of the 2x2 Bayer quad
    int inX = int(x) * 2;
    int inY = int(y) * 2;
    int idx = inY * w + inX;  // index into input plane

    // Read uint32 packed INT16 values for the 2x2 block
    // Each uint32 holds 2 INT16 pixels packed in little-endian order
    uint packed00_01 = in_data[idx];
    uint packed10_11 = in_data[idx + w];
    uint raw00 = packed00_01 & 0xFFFFu;
    uint raw01 = packed00_01 >> 16;
    uint raw10 = packed10_11 & 0xFFFFu;
    uint raw11 = packed10_11 >> 16;

    // Read per-channel BLC scalars {R, Gr, Gb, B} (4 scalars total, in sensor units)
    float blcR  = blc_data[0];  // R channel BLC
    float blcGr = blc_data[1];  // Gr channel BLC
    float blcGb = blc_data[2];  // Gb channel BLC
    float blcB  = blc_data[3];  // B channel BLC

    // Convert raw to float, subtract BLC, normalize to [0,1]
    float sensorMax = u.sensorMax > 0.0 ? u.sensorMax : 1023.0;
    float norm00 = (float(raw00) - blcR) / sensorMax;
    float norm01 = (float(raw01) - blcGr) / sensorMax;
    float norm10 = (float(raw10) - blcGb) / sensorMax;
    float norm11 = (float(raw11) - blcB) / sensorMax;

    // Clamp to [0,1] after BLC subtraction
    norm00 = clamp(norm00, 0.0, 1.0);
    norm01 = clamp(norm01, 0.0, 1.0);
    norm10 = clamp(norm10, 0.0, 1.0);
    norm11 = clamp(norm11, 0.0, 1.0);

    // Output: [1,4,H/2,W/2] where channels are R, Gr, Gb, B
    int outIdx = (int(y) * outW + int(x)) * 4;
    out_data[outIdx + 0] = norm00;  // R
    out_data[outIdx + 1] = norm01;  // Gr
    out_data[outIdx + 2] = norm10;  // Gb
    out_data[outIdx + 3] = norm11;  // B
}