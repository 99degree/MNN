#version 450
// isp.crop_blc_norm_cfa — fused Crop + RawBLC + Normalize + CFA unpack.
//
// Input:  float[1,1,H_src,W_src] — one float per raw pixel (JNI converts the
//         camera's INT16 MIPI data to float before feeding; values 0..sensorMax).
// Output: float[1,4,H_dst,W_dst] NCHW PLANAR quad channels [TL,TR,BL,BR] where
//         H_dst = H_src/2, W_dst = W_src/2. Planar layout matches the
//         isp.lsc_min / isp.demosaic_g2 consumers (LAYOUT CONTRACT 2026-10-17).
//
// Bindings (universal isp.* positional map):
//   binding 0 = {W_src, H_src, sensorMax, pad} — W/H hot-swapped from the real
//               input tensor dims at first encode (elementwise attr).
//   binding 1 = input frame  (float raw plane)
//   binding 2 = output frame (float quad planes, planar)
//   binding 3 = per-channel BLC {R, Gr, Gb, B} in sensor units (float[4])
//
// The previous version read uint32-packed INT16 pairs and wrote interleaved
// output — both wrong for the float-input JNI feed and the planar downstream
// contract (uniform near-white output: float bits reinterpreted as INT16
// pairs produced garbage values that clamped to 1.0).

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) buffer Uniforms {
    float width;
    float height;
    float sensorMax;
    float pad;
} u;

layout(set = 0, binding = 1) readonly  buffer InBuf  { float in_data[]; };
layout(set = 0, binding = 2) writeonly buffer OutBuf { float out_data[]; };
layout(set = 0, binding = 3) readonly  buffer BlcBuf { float blc_data[]; };

void main() {
    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;
    int w = int(u.width);
    int h = int(u.height);
    int outW = w / 2;
    int outH = h / 2;
    if (int(x) >= outW || int(y) >= outH) return;

    // Top-left pixel of the 2x2 Bayer quad in the full-res plane
    int inX = int(x) * 2;
    int inY = int(y) * 2;
    int idx = inY * w + inX;

    // Read the four raw pixels directly as floats (JNI already converted INT16→float)
    float raw00 = in_data[idx];           // TL
    float raw01 = in_data[idx + 1];       // TR
    float raw10 = in_data[idx + w];       // BL
    float raw11 = in_data[idx + w + 1];   // BR

    // Per-channel BLC scalars {R, Gr, Gb, B} in sensor units
    float blcR  = blc_data[0];
    float blcGr = blc_data[1];
    float blcGb = blc_data[2];
    float blcB  = blc_data[3];

    // Normalize to [0,1] after BLC subtraction
    float sensorMax = u.sensorMax > 0.0 ? u.sensorMax : 1023.0;
    float norm00 = (raw00 - blcR)  / sensorMax;
    float norm01 = (raw01 - blcGr) / sensorMax;
    float norm10 = (raw10 - blcGb) / sensorMax;
    float norm11 = (raw11 - blcB)  / sensorMax;

    if (norm00 < 0.0) norm00 = 0.0; else if (norm00 > 1.0) norm00 = 1.0;
    if (norm01 < 0.0) norm01 = 0.0; else if (norm01 > 1.0) norm01 = 1.0;
    if (norm10 < 0.0) norm10 = 0.0; else if (norm10 > 1.0) norm10 = 1.0;
    if (norm11 < 0.0) norm11 = 0.0; else if (norm11 > 1.0) norm11 = 1.0;

    // Output: [1,4,H/2,W/2] PLANAR — plane stride = outW*outH
    int plane = outW * outH;
    int oidx = int(y) * outW + int(x);
    out_data[0 * plane + oidx] = norm00;  // TL
    out_data[1 * plane + oidx] = norm01;  // TR
    out_data[2 * plane + oidx] = norm10;  // BL
    out_data[3 * plane + oidx] = norm11;  // BR
}
