#version 450
// isp.demosaic_ccm — 1x1 conv from the 4-plane CFA quad to planar RGB, plus the
// clip the primitive form expresses as a separate Clip node.
//
// Replaces a placeholder that copied its input, which is why enabling it
// deleted both demosaic and CCM at once.
//
// Inputs (universal isp.* map):
//   binding 3 = frame  [1,4,H,W] planar CFA quad (TL, TR, BL, BR)
//   binding 5 = WBuf   [3,4,1,1] — row-major [out_ch][in_ch][1][1]. The engine
//              bakes CCM x demosaic into these 12 weights, so the shader does
//              not need to know the Bayer pattern.
//   binding 6 = BBuf   [3]
// Output:
//   binding 4 = frame  [1,3,H,W] planar RGB, clipped to [0,1]
//
// Note the plane strides differ: four input planes, three output planes. Using
// one stride for both is the kind of error that shows as a sheared image rather
// than an obviously broken one.

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) buffer Uniforms {
    float width;
    float height;
    float pad0;
    float pad1;
} u;

layout(set = 0, binding = 3) readonly  buffer InBuf  { float in_data[]; };
layout(set = 0, binding = 4) writeonly buffer OutBuf { float out_data[]; };
layout(set = 0, binding = 5) readonly  buffer WBuf   { float weights[]; };
layout(set = 0, binding = 6) readonly  buffer BBuf   { float bias[]; };

void main() {
    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;
    int w = int(u.width);
    int h = int(u.height);
    if (int(x) >= w || int(y) >= h) return;

    int in_plane  = w * h;   // 4 planes of the quad
    int out_plane = w * h;   // 3 planes of RGB — same pixel count, different count of planes
    int p = int(y) * w + int(x);

    float q0 = in_data[0 * in_plane + p]; // TL
    float q1 = in_data[1 * in_plane + p]; // TR
    float q2 = in_data[2 * in_plane + p]; // BL
    float q3 = in_data[3 * in_plane + p]; // BR

    for (int c = 0; c < 3; ++c) {
        int base = c * 4;
        float acc = bias[c]
                  + weights[base + 0] * q0
                  + weights[base + 1] * q1
                  + weights[base + 2] * q2
                  + weights[base + 3] * q3;
        out_data[c * out_plane + p] = clamp(acc, 0.0, 1.0);
    }
}
