#version 450
// isp.display_uint32_argb — RGB planes → packed uint32 ARGB8888.
// Input:  [1,3,h,w] float NCHW planes (R,G,B), values in [0,1].
// Output: [1,1,h,w] uint32 ARGB (each uint32 = a<24|r<16|g<8|b, LE byte order: B,G,R,A).
//   - One uint32 per pixel. Alpha=255 at bits[31:24], R=bits[23:16], G=bits[15:8], B=bits[7:0].
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;
layout(set = 0, binding = 0, std430) buffer Uniforms {
    float width; float height; float gamma; float pad;
} u;
layout(set = 0, binding = 1) readonly  buffer InBuf  { float in_data[]; };
layout(set = 0, binding = 2) writeonly buffer OutBuf { uint out_data[]; };

// Pack float [0,1] to uint8 with gamma correction and saturation (GLSL 450: conditional)
uint packChannel(float val, float invGamma) {
    if (val < 0.0) val = 0.0;
    val = pow(val, invGamma);
    val = val * 255.0;
    if (val < 0.0) val = 0.0;
    else if (val > 255.0) val = 255.0;
    return uint(val);
}

void main() {
    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;
    int w = int(u.width);
    int h = int(u.height);
    if (int(x) >= w || int(y) >= h) return;
    int idx = int(y) * w + int(x);
    int sz = w * h;
    float invGamma = 1.0 / max(u.gamma, 1e-6);
    float r = in_data[sz * 0 + idx];
    float g = in_data[sz * 1 + idx];
    float b = in_data[sz * 2 + idx];
    uint ur = packChannel(r, invGamma);
    uint ug = packChannel(g, invGamma);
    uint ub = packChannel(b, invGamma);
    // Pack ARGB8888 as uint32: alpha<<24 | r<<16 | g<<8 | b (LE: B,G,R,A).
    // Output shape [1,1,h,w] uint32 (one uint32 per pixel, each = a<24|r<16|g<8|b).
    uint packed = (255u << 24) | (ub << 16) | (ug << 8) | ur;
    out_data[idx] = packed;
}