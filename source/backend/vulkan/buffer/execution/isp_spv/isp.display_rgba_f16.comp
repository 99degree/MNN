#version 450
// isp.display_rgba_f16 — write RGBA float16 directly into an
// AHARDWAREBUFFER_FORMAT_R16G16B16A16_FLOAT display buffer.
//
// One packed uint32 per TWO lanes: 8 bytes (four half lanes) per pixel, written
// straight from the float ISP domain. No uint8 packing, no per-pixel *255, no
// byte-order ambiguity: the shader output IS the AHB layout.
//
// WHY uint + packHalf2x16 AND NOT float16_t: a shader declaring float16_t needs
// the Vulkan `shaderFloat16` feature enabled. When it is not, Adreno fails
// pipeline creation, and the subsequent vkDestroyPipeline on that half-built
// pipeline SIGSEGVs INSIDE the driver (the crash log's fault address
// 0x3c003c003c00 is literally half-float 1.0s sitting where a pointer belongs).
// packHalf2x16 is a CORE GLSL 450 function that needs no float16 arithmetic
// feature and no float16 storage type — it just rounds two floats to halves and
// packs them into a uint. So this shader runs on any Vulkan 1.0 device.
//
// Uniforms (binding 0): {W, H, gamma, fullScale}
//   fullScale = numeric full-scale of the incoming frame (1.0 if the chain
//   normalized, sensorMax e.g. 1023 if not). value / fullScale -> [0,1] which
//   is written straight to the float16 buffer. Writing [0,1] float16 maps
//   linearly to full display brightness, so no per-pixel cast to uint8 is
//   needed and the chain need not be normalized first.
// gamma > 0 applies an extra encode (gamma==1 skips).
//
// In : float[1,3,H,W] NCHW planar RGB, in fullScale units.
// Out: [1,1,H,W] uint32 x2 per pixel = LE half lanes [R16,G16,B16,A16],
//      8 bytes per pixel. (Declared [1,H,W,4] float16 / NHWC in ShapeIspExtra —
//      that layout is byte-identical to this write.)

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) buffer Uniforms {
    float width;
    float height;
    float gamma;
    float fullScale;
    float pad0;
    float pad1;
    float pad2;
    float pad3;
} u;

layout(set = 0, binding = 1) readonly  buffer InBuf  { float in_data[]; };
layout(set = 0, binding = 2, std430) writeonly buffer OutBuf { uint out_data[]; };

void main() {
    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;
    int w = int(u.width);
    int h = int(u.height);
    if (int(x) >= w || int(y) >= h) return;
    int idx = int(y) * w + int(x);
    int sz = w * h;

    float c0 = in_data[0 * sz + idx];
    float c1 = in_data[1 * sz + idx];
    float c2 = in_data[2 * sz + idx];

    float fs = u.fullScale;
    if (!(fs > 1e-6)) fs = 1.0;
    c0 = clamp(c0 / fs, 0.0, 1.0);
    c1 = clamp(c1 / fs, 0.0, 1.0);
    c2 = clamp(c2 / fs, 0.0, 1.0);

    float g = u.gamma;
    if (g > 0.0001f && abs(g - 1.0f) > 0.0001f) {
        float invg = 1.0 / g;
        c0 = pow(clamp(c0, 0.0, 1.0), invg);
        c1 = pow(clamp(c1, 0.0, 1.0), invg);
        c2 = pow(clamp(c2, 0.0, 1.0), invg);
    }

    // Two uint32s per pixel => four half lanes, LE: R,G,B,A.
    // packHalf2x16 puts the FIRST component in the low 16 bits, so the low
    // word is [R16, G16] and the high word is [B16, A16] on a little-endian
    // wire — exactly AHARDWAREBUFFER_FORMAT_R16G16B16A16_FLOAT.
    out_data[idx * 2 + 0] = packHalf2x16(vec2(c0, c1));
    out_data[idx * 2 + 1] = packHalf2x16(vec2(c2, 1.0));
}
