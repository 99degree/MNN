#version 450
// isp.chromatic_aberration_min — MINIMAL opset lateral CA correction.
// 
// PROCEDURAL lateral CA correction from minimal uniform parameters.
// NO large tensor inputs - CA displacement grids generated procedurally.
// 
// Uniform parameters (binding 0):
//   width, height: frame dimensions
//   cx, cy: center coordinates (pixel)
//   k_r, k_b: radial polynomial coefficients for R and B channels
//   strength: CA correction strength [0,1]

#extension GL_EXT_scalar_block_layout : require

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) buffer Uniforms {
    float width;
    float height;
    float cx;
    float cy;
    float k_r;
    float k_b;
    float strength;
} u;

layout(set = 0, binding = 1) readonly  buffer InBuf  { float in_data[]; };
layout(set = 0, binding = 2) writeonly buffer OutBuf { float out_data[]; };

// Bilinear sampler using the globally bound InBuf (binding 1)
float sampleIn(float x, float y, int w, int h, int c, int channels) {
    int xi = int(floor(x));
    int yi = int(floor(y));
    float fx = x - float(xi);
    float fy = y - float(yi);
    xi = (xi < 0 ? 0 : (xi > w - 1 ? w - 1 : xi));
    yi = (yi < 0 ? 0 : (yi > h - 1 ? h - 1 : yi));
    int xi1 = (xi + 1 > w - 1 ? w - 1 : xi + 1);
    int yi1 = (yi + 1 > h - 1 ? h - 1 : yi + 1);
    int base = (yi * w + xi) * channels + c;
    int base_x = (yi * w + xi1) * channels + c;
    int base_y = (yi1 * w + xi) * channels + c;
    int base_xy = (yi1 * w + xi1) * channels + c;
    float v00 = in_data[base];
    float v10 = in_data[base_x];
    float v01 = in_data[base_y];
    float v11 = in_data[base_xy];
    return mix(mix(v00, v10, fx), mix(v01, v11, fx), fy);
}

void main() {
    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;
    int w = int(u.width);
    int h = int(u.height);
    if (int(x) >= w || int(y) >= h) return;
    
    // Normalized coordinates [-1, 1] relative to center
    float fx = (float(x) - u.cx) / (u.cx > 0.0 ? u.cx : 1.0);
    float fy = (float(y) - u.cy) / (u.cy > 0.0 ? u.cy : 1.0);
    float r2 = fx * fx + fy * fy;
    float r = sqrt(r2);
    
    // Lateral CA displacement: dr = k * r^2 * sign(x) * strength
    // sign(fx) = (fx > 0.0 ? 1.0 : (fx < 0.0 ? -1.0 : 0.0))
    float sgn = (fx > 0.0 ? 1.0 : (fx < 0.0 ? -1.0 : 0.0));
    float dr = u.k_r * r2 * sgn * u.strength;
    float db = u.k_b * r2 * sgn * u.strength;
    
    // Source coordinates for R and B channels (G is reference at center)
    float src_x_r = float(x) + dr;
    float src_x_b = float(x) + db;
    float src_y = float(y);
    
    // Clamp to valid range
    src_x_r = (src_x_r < 0.0 ? 0.0 : (src_x_r > float(w - 1) ? float(w - 1) : src_x_r));
    src_x_b = (src_x_b < 0.0 ? 0.0 : (src_x_b > float(w - 1) ? float(w - 1) : src_x_b));
    src_y = (src_y < 0.0 ? 0.0 : (src_y > float(h - 1) ? float(h - 1) : src_y));
    
    // Sample R channel (channel 0), G channel (channel 1), B channel (channel 2)
    // Input is [1, 3, H, W] NCHW layout: channels=3, stride = w*h
    int channels = 3;
    int stride = w * h;
    
    // R channel (warped)
    float r_val = sampleIn(src_x_r, src_y, w, h, 0, channels);
    // G channel (reference, no warp)
    float g_val = sampleIn(float(x), float(y), w, h, 1, channels);
    // B channel (warped)
    float b_val = sampleIn(src_x_b, src_y, w, h, 2, channels);
    
    // Output is [1, 3, H, W] NCHW
    int idx = (int(y) * w + int(x));
    out_data[idx + 0 * stride] = r_val;
    out_data[idx + 1 * stride] = g_val;
    out_data[idx + 2 * stride] = b_val;
}