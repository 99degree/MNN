#version 450
// isp.display_uint8_argb — RGB planes → packed uint8 ARGB8888.
// Input:  [1,3,h,w] float NCHW planes (R,G,B), values in [0,1].
// Output: [1,h,w,4] packed uint32 ARGB (little-endian wire: B,G,R,A).
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;
layout(set = 0, binding = 0, std430) buffer Uniforms {
    float width; float height; float gamma; float pad;
} u;
layout(set = 0, binding = 1) readonly  buffer InBuf  { float in_data[]; };
layout(set = 0, binding = 2) writeonly buffer OutBuf { uint out_data[]; };

void main() {
    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;
    int w = int(u.width);
    int h = int(u.height);
    if (int(x) >= w || int(y) >= h) return;
    int idx = int(y) * w + int(x);
    int sz = w * h;
    float invGamma = 1.0 / max(u.gamma, 1e-6);
    float r = clamp(pow(max(in_data[sz * 0 + idx], 0.0), invGamma) * 255.0, 0.0, 255.0);
    float g = clamp(pow(max(in_data[sz * 1 + idx], 0.0), invGamma) * 255.0, 0.0, 255.0);
    float b = clamp(pow(max(in_data[sz * 2 + idx], 0.0), invGamma) * 255.0, 0.0, 255.0);
    // Pack ARGB8888: LE memory order B,G,R,A with A=255.
    uint packed = (255u << 24) | (uint(b) << 16) | (uint(g) << 8) | uint(r);
    out_data[idx] = packed;
}
