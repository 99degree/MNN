#version 450
// isp.demosaic_edge_ccm — fused edge-aware demosaic + color correction matrix.
// Replaces chain: isp.demosaic_edge → isp.ccm
// Input: single-channel (grayscale from edge-aware demosaic) [1,1,H,W]
// Output: 3-channel RGB [1,3,H,W] with CCM applied
//
// Uniforms (binding 0): {width, height, pattern, pad, ccm[9], offr, offg, offb}
// CCM is row-major 3x3: [ccm00 ccm01 ccm02; ccm10 ccm11 ccm12; ccm20 ccm21 ccm22]
// Offsets: offr, offg, offb added after matrix multiply
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) buffer Uniforms {
    float width;
    float height;
    float pattern;
    float pad;
    float ccm00; float ccm01; float ccm02;
    float ccm10; float ccm11; float ccm12;
    float ccm20; float ccm21; float ccm22;
    float offr; float offg; float offb;
    float pad2;
} u;

layout(set = 0, binding = 1) readonly  buffer InBuf  { float in_data[]; };
layout(set = 0, binding = 2) writeonly buffer OutBuf { float out_data[]; };

void main() {
    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;
    int w = int(u.width);
    int h = int(u.height);
    if (int(x) >= w || int(y) >= h) return;

    int idx = int(y) * w + int(x);
    float c = in_data[idx];  // single channel input

    // Demosaic edge: replicate to 3 channels (R=G=B=c)
    float r = c;
    float g = c;
    float b = c;

    // Apply 3x3 CCM (row-major)
    float r_out = u.ccm00 * r + u.ccm01 * g + u.ccm02 * b + u.offr;
    float g_out = u.ccm10 * r + u.ccm11 * g + u.ccm12 * b + u.offg;
    float b_out = u.ccm20 * r + u.ccm21 * g + u.ccm22 * b + u.offb;

    // Output 3-channel RGB
    int out_idx = idx * 3;
    out_data[out_idx + 0] = r_out;
    out_data[out_idx + 1] = g_out;
    out_data[out_idx + 2] = b_out;
}