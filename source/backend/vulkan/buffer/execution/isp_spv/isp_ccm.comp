#version 450
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;
layout(set = 0, binding = 0, std430) buffer Uniforms {
    float width; float height; float ccm00; float ccm01; float ccm02;
    float ccm10; float ccm11; float ccm12; float ccm20; float ccm21; float ccm22;
    float offr; float offg; float offb; float pad;
} u;
layout(set = 0, binding = 1) readonly  buffer InBuf  { float in_data[]; };
layout(set = 0, binding = 2) writeonly buffer OutBuf { float out_data[]; };

void main() {
    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;
    int w = int(u.width);
    int h = int(u.height);
    if (int(x) >= w || int(y) >= h) return;
    int idx = (int(y) * w + int(x)) * 3;
    float r = in_data[idx + 0];
    float g = in_data[idx + 1];
    float b = in_data[idx + 2];
    out_data[idx + 0] = u.ccm00 * r + u.ccm01 * g + u.ccm02 * b + u.offr;
    out_data[idx + 1] = u.ccm10 * r + u.ccm11 * g + u.ccm12 * b + u.offg;
    out_data[idx + 2] = u.ccm20 * r + u.ccm21 * g + u.ccm22 * b + u.offb;
}
