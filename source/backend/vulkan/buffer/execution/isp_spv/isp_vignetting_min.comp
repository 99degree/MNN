#version 450
// isp.vignetting_min — MINIMAL opset vignetting correction.
// 
// PROCEDURAL vignetting correction from minimal uniform parameters.
// NO large tensor inputs - vignetting gain computed per-pixel from radial polynomial.
// 
// Uniform parameters (binding 0):
//   width, height: frame dimensions
//   cx, cy: center coordinates (normalized or pixel)
//   k0, k1, k2: radial polynomial coefficients
//   strength: vignetting strength [0,1]

#version 450
#extension GL_EXT_scalar_block_layout : require

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) buffer Uniforms {
    float width;
    float height;
    float cx;
    float cy;
    float k0;
    float k1;
    float k2;
    float strength;
} u;

layout(set = 0, binding = 1, std430) readonly buffer InBuf { float in_data[]; };
layout(set = 0, binding = 2, std430) writeonly buffer OutBuf { float out_data[]; };

void main() {
    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;
    int w = int(u.width);
    int h = int(u.height);
    if (int(x) >= w || int(y) >= h) return;
    
    // Normalized coordinates relative to center
    float dx = float(x) - u.cx;
    float dy = float(y) - u.cy;
    float r2 = dx * dx + dy * dy;
    float falloff = 1.0 / (u.k0 + u.k1 * sqrt(r2) + u.k2 * r2);
    falloff = 1.0 + (falloff - 1.0) * u.strength;
    
    int idx = (int(y) * w + int(x)) * 3;
    out_data[idx + 0] = in_data[idx + 0] * falloff;
    out_data[idx + 1] = in_data[idx + 1] * falloff;
    out_data[idx + 2] = in_data[idx + 2] * falloff;
}
