#version 450
// isp.vignetting_min — MINIMAL opset mechanical vignetting correction.
// 
// PROCEDURAL vignetting from minimal uniform parameters.
// NO large tensor inputs - gain computed from radial falloff model.
// 
// Uniform parameters (binding 0):
//   width, height: frame dimensions
//   cx, cy: center coordinates (pixel)
//   k0, k1, k2: radial polynomial coefficients
//   strength: vignetting strength [0,1]
//   (matches non-minimal layout for compatibility)

#extension GL_EXT_scalar_block_layout : require

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) buffer Uniforms {
    float width;
    float height;
    float cx;
    float cy;
    float k0;
    float k1;
    float k2;
    float strength;
} u;

layout(set = 0, binding = 1) readonly buffer InBuf { float in_data[]; };
layout(set = 0, binding = 2) writeonly buffer OutBuf { float out_data[]; };

void main() {
    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;
    int w = int(u.width);
    int h = int(u.height);
    if (int(x) >= w || int(y) >= h) return;
    float dx = float(x) - u.cx;
    float dy = float(y) - u.cy;
    float r2 = dx * dx + dy * dy;
    float falloff = 1.0 / (u.k0 + u.k1 * sqrt(r2) + u.k2 * r2);
    falloff = 1.0 + (falloff - 1.0) * u.strength;
    // PLANAR [1,3,H,W]: pixel p, channel k at k*plane + p.
    int p = int(y) * w + int(x);
    int plane = w * h;
    out_data[0 * plane + p] = in_data[0 * plane + p] * falloff;
    out_data[1 * plane + p] = in_data[1 * plane + p] * falloff;
    out_data[2 * plane + p] = in_data[2 * plane + p] * falloff;
}