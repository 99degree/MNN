#version 450
#extension GL_EXT_scalar_block_layout : require

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) uniform Uniforms {
    float width;
    float height;
    float cropW;
    float cropH;
    float startW;
    float startH;
    float gain;
};

layout(set = 0, binding = 1, std430) readonly buffer InBuf {
    float in_data[];
};

layout(set = 0, binding = 2, std430) writeonly buffer OutBuf {
    float out_data[];
};

layout(set = 0, binding = 3, std430) readonly buffer BlcBuf {
    float blc_data[];
};

void main() {
    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;

    int ow = int(cropW);
    int oh = int(cropH);

    if (x >= uint(ow) || y >= uint(oh)) return;

    int w = int(width);
    int h = int(height);
    int sx = int(startW) + int(x);
    int sy = int(startH) + int(y);

    if (sx >= 0 && sx < w && sy >= 0 && sy < h) {
        int srcIdx = (sy * w + sx) * 3;
        int dstIdx = (int(y) * ow + int(x)) * 3;

        float r = in_data[srcIdx + 0];
        float g = in_data[srcIdx + 1];
        float b = in_data[srcIdx + 2];

        float blc_r = blc_data[srcIdx + 0];
        float blc_g = blc_data[srcIdx + 1];
        float blc_b = blc_data[srcIdx + 2];

        out_data[dstIdx + 0] = (r - blc_r) * gain;
        out_data[dstIdx + 1] = (g - blc_g) * gain;
        out_data[dstIdx + 2] = (b - blc_b) * gain;
    }
}
