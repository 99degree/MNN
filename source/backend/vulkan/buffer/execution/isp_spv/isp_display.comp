#version 450
// isp.display — planar RGB in, planar RGB out, sRGB-encoded.
//
// Rewritten twice over. First it read `gamma` from a `const` attribute that no
// softisp block emitted, so `pow(x, 0)` returned 1.0 for every pixel. Then the
// `const` attribute turned out to break `resizeSession` (COMPUTE_SIZE_ERROR).
// Gamma now arrives the same way every other fused op's coefficients do — as a
// graph input the engine writes each frame.
//
// Inputs:
//   binding 3 = frame    [1,3,H,W] planar RGB
//   binding 5 = GammaBuf [1]       display gamma (2.4 for sRGB)
// Output:
//   binding 4 = frame    [1,3,H,W] planar RGB, sRGB-encoded
//
// W/H still come from the params block (binding 0), which VulkanFuse fills from
// the real input tensor when the op is marked `elementwise`.
//
// The primitive path emits `Pow(x, 1/2.4)`, so the exponent is `1/gamma` and
// gamma is the *display* gamma — passing 1/2.4 here would invert the curve.

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) buffer Uniforms {
    float width;
    float height;
    float unused0;
    float unused1;
} u;

layout(set = 0, binding = 3) readonly  buffer InBuf   { float in_data[]; };
layout(set = 0, binding = 4) writeonly buffer OutBuf  { float out_data[]; };
layout(set = 0, binding = 5) readonly  buffer GammaBuf { float gamma[]; };

void main() {
    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;
    int w = int(u.width);
    int h = int(u.height);
    if (int(x) >= w || int(y) >= h) return;

    // A zero gamma would make the exponent infinite; fall back to sRGB rather
    // than emitting NaN or a white frame.
    float g = gamma[0];
    if (g <= 0.01) g = 2.4;
    float invGamma = 1.0 / g;

    int plane = w * h;
    int p = int(y) * w + int(x);
    for (int c = 0; c < 3; ++c) {
        int i = c * plane + p;
        out_data[i] = clamp(pow(max(in_data[i], 0.0), invGamma), 0.0, 1.0);
    }
}
