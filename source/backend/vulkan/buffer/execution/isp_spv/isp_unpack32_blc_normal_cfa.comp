#version 450
// isp.unpack32_blc_normal_cfa — normalize + BLC + quad unpack from FLOAT32 RAW in one dispatch.
// Input:  [1,1,H,W] FLOAT32 raw Bayer plane (host converted u16->f32 by engine RawFloat path).
// Output: [1,4,H/2,W/2] NCHW float PLANAR quad: plane p holds channel p of
//         every quad — [TL, TR, BL, BR] = [R, G1, G2, B] for RGGB.
//
// Replaces the host-side INT16→FLOAT32 conversion + unpack split + normalize + BLC + CFA
// by doing it all on GPU. The engine converts u16→f32 on CPU (RawFloat mode) and the shader
// divides by sensor_max, subtracts BLC, and unpacks the 2x2 Bayer sites.
//
// Bindings follow the universal isp.* convention (VulkanFuse.cpp):
//   binding 0 = Uniforms {width, height, sensor_max, gain, blc_offsets[4], bayer_pattern}
//   binding 3 = input FLOAT32 plane (readonly)    <- input[0], the frame
//   binding 4 = output float quad planes          <- output[0]
//   binding 5 = black level per colour (R, Gr, Gb, B)
//   binding 6 = sensor white level
//   binding 7 = CFA phase

#extension GL_EXT_scalar_block_layout : require

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) buffer Uniforms {
    float width;        // source (full-res) W
    float height;       // source (full-res) H
    float sensor_max;   // sensor white level (e.g., 1023.0 or 65535.0)
    float gain;         // post-BLC gain (typically 1.0)
    float blc_r;        // BLC offsets in sensor counts (0..sensor_max)
    float blc_gr;
    float blc_gb;
    float blc_b;
    int   bayer_pattern; // 0=RGGB, 1=GRBG, 2=GBRG, 3=BGGR
} u;

layout(set = 0, binding = 3) readonly  buffer InBuf  { float in_data[]; };
layout(set = 0, binding = 4) writeonly buffer OutBuf { float out_data[]; };
layout(set = 0, binding = 5) readonly  buffer BlcBuf { float blc_vals[]; };
layout(set = 0, binding = 6) readonly  buffer MaxBuf { float max_val[]; };
layout(set = 0, binding = 7) readonly  buffer BayerBuf { int bayer_pattern[]; };

void main() {
    uint x = gl_GlobalInvocationID.x;   // quad column
    uint y = gl_GlobalInvocationID.y;   // quad row
    int srcW = int(u.width);
    int srcH = int(u.height);
    int qw = srcW / 2;
    int qh = srcH / 2;
    if (int(x) >= qw || int(y) >= qh) return;

    int inX = int(x) * 2;
    int inY = int(y) * 2;
    int base = inY * srcW + inX;
    int idx  = int(y) * qw + int(x);       // quad index
    uint plane = uint(qw) * uint(qh);      // plane stride

    // The coefficient tensors, not the params block, are authoritative: the
    // engine writes them as graph inputs each frame (BLC/WB/AE may change).
    float smax = max(max_val[0], 1.0);
    int   p    = bayer_pattern[0];

    // BLC offsets in [0, 1] (normalized by sensor_max)
    float blc0 = blc_vals[0] / smax;
    float blc1 = blc_vals[1] / smax;
    float blc2 = blc_vals[2] / smax;
    float blc3 = blc_vals[3] / smax;

    // Read 2x2 Bayer sites from FLOAT32 raw plane
    float tl = in_data[base];              // TL
    float tr = in_data[base + 1];          // TR
    float bl = in_data[base + srcW];       // BL
    float br = in_data[base + srcW + 1];   // BR

    // Normalize by sensor_max
    tl /= smax; tr /= smax; bl /= smax; br /= smax;

    // Bayer phase determines colour -> plane mapping
    // RGGB (0): plane0=R(TL), plane1=G1(TR), plane2=G2(BL), plane3=B(BR)
    // GRBG (1): plane0=G1(TL), plane1=R(TR), plane2=B(BL), plane3=G2(BR)
    // GBRG (2): plane0=G2(TL), plane1=B(TR), plane2=R(BL), plane3=G1(BR)
    // BGGR (3): plane0=B(TL), plane1=G2(TR), plane2=G1(BL), plane3=R(BR)

    float r, g1, g2, b;

    if (p == 0) { // RGGB
        r = tl; g1 = tr; g2 = bl; b = br;
    } else if (p == 1) { // GRBG
        g1 = tl; r = tr; b = bl; g2 = br;
    } else if (p == 2) { // GBRG
        g2 = tl; b = tr; r = bl; g1 = br;
    } else { // BGGR (3)
        b = tl; g2 = tr; g1 = bl; r = br;
    }

    // Apply BLC and gain, clamp to >= 0
    float gain = u.gain;
    r  = max(r  - blc0, 0.0) * gain;
    g1 = max(g1 - blc1, 0.0) * gain;
    g2 = max(g2 - blc2, 0.0) * gain;
    b  = max(b  - blc3, 0.0) * gain;

    // Write to planar quad output
    out_data[idx]               = r;
    out_data[plane + idx]       = g1;
    out_data[plane * 2u + idx]  = g2;
    out_data[plane * 3u + idx]  = b;
}