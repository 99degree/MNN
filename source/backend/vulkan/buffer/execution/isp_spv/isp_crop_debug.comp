#version 450
#extension GL_EXT_scalar_block_layout : require
// DEBUG BISECT v3: UNCONDITIONAL write at the very top of main(), BEFORE any
// guard — distinguishes "shader never runs" (out[0] stays 0) from "shader runs
// but the guard blocks" (out[0] == 12345 and/or in[0] == -999).
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) buffer Uniforms {
    float width;
    float height;
    float cropW;
    float cropH;
    float startW;
    float startH;
};

layout(set = 0, binding = 1, std430) buffer InBuf {
    float in_data[];
};

layout(set = 0, binding = 2) writeonly buffer OutBuf {
    float out_data[];
};

void main() {
    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;
    // Unconditional proof-of-execution writes (no guard, no uniformity).
    if (x == 0u && y == 0u) {
        out_data[0] = 12345.0;
        in_data[0]  = -999.0;
    }
    int ow = int(cropW);
    int oh = int(cropH);
    if (ow <= 0) ow = int(width);
    if (oh <= 0) oh = int(height);
    if (int(x) >= ow || int(y) >= oh) return;
    int idx = int(y) * ow + int(x);
    out_data[idx] = float(idx);
}
