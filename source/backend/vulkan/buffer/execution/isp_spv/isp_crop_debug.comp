#version 450
#extension GL_EXT_scalar_block_layout : require
// DEBUG BISECT v2: writes BOTH bindings.
//   out_data[idx] = float(idx)       -> write path proof (expect 0,1,2,...)
//   in_data[idx]  = -float(idx)      -> execution proof (probe [ISP-IN] on the
//     NEXT frame's capture should show NEGATIVE values at [0..7]; note the
//     upload overwrites in_data before the next dispatch, so a negative
//     first-8 means our write landed and the feed did NOT overwrite it).
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) uniform Uniforms {
    float width;
    float height;
    float cropW;
    float cropH;
    float startW;
    float startH;
};

layout(set = 0, binding = 1, std430) buffer InBuf {
    float in_data[];
};

layout(set = 0, binding = 2) writeonly buffer OutBuf {
    float out_data[];
};

void main() {
    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;
    int ow = int(cropW);
    int oh = int(cropH);
    if (ow <= 0) ow = int(width);
    if (oh <= 0) oh = int(height);
    if (int(x) >= ow || int(y) >= oh) return;
    int idx = int(y) * ow + int(x);
    out_data[idx] = float(idx);
    if (idx < 8) {
        in_data[idx] = -float(idx) - 1.0;  // -1,-2,...-8 markers
    }
}
