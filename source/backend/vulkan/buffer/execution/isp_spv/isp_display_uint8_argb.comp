#version 450
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;
layout(set = 0, binding = 0, std430) buffer Uniforms {
    float width; float height; float gamma; float pad;
} u;
layout(set = 0, binding = 1) readonly  buffer InBuf  { float in_data[]; };
layout(set = 0, binding = 2) writeonly buffer OutBuf { uint out_data[]; };

void main() {
    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;
    int w = int(u.width);
    int h = int(u.height);
    if (int(x) >= w || int(y) >= h) return;
    int idx = (int(y) * w + int(x)) * 3;
    float r = in_data[idx + 0];
    float g = in_data[idx + 1];
    float b = in_data[idx + 2];
    float invGamma = 1.0 / u.gamma;
    // Apply gamma correction, scale to [0,255], clamp
    r = clamp(pow(max(r, 0.0), invGamma) * 255.0, 0.0, 255.0);
    g = clamp(pow(max(g, 0.0), invGamma) * 255.0, 0.0, 255.0);
    b = clamp(pow(max(b, 0.0), invGamma) * 255.0, 0.0, 255.0);
    // Pack as uint8 ARGB8888: A=255, B, G, R (byte order: B,G,R,A in memory on little-endian)
    uint alpha = 255u;
    uint packed = (alpha << 24) | (uint(b) << 16) | (uint(g) << 8) | uint(r);
    int outidx = (int(y) * w + int(x));
    out_data[outidx] = packed;
}
