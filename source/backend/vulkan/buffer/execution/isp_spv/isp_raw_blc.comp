#version 450
#extension GL_EXT_scalar_block_layout : require

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) buffer Uniforms {
    float width;
    float height;
    float black_r;
    float black_g;
    float black_b;
    float gain;
};

layout(set = 0, binding = 1, std430) readonly buffer InBuf {
    float in_data[];
};

layout(set = 0, binding = 2, std430) writeonly buffer OutBuf {
    float out_data[];
};

void main() {
    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;

    int w = int(width);
    int h = int(height);

    if (int(x) >= w || int(y) >= h) return;

    int idx = int(y) * w + int(x);

    // 1-CHANNEL RAW PLANE. The input is a Bayer mosaic [1,1,H,W] (one sample
    // per pixel), so every raw-domain op addresses it linearly. The previous
    // '[...] * 3' + three per-channel writes assumed a 3-channel packed plane
    // that this pipeline never produces: with grid=[W/16,H/16] over a
    // [1,1,H,W] buffer it wrote 3*H*W floats, i.e. THREE TIMES past the end
    // of the output allocation — an out-of-bounds GPU write (garbage output
    // and the libMNN_Vulkan SIGSEGV).
    //
    // The per-position Bayer black level is applied after CFA (isp.blc_min,
    // one coefficient per quad channel), so a scalar here is correct: the
    // baseline const is {W,H,0,0,0,gain=1} (pure passthrough).
    out_data[idx] = (in_data[idx] - black_r) * gain;
}
