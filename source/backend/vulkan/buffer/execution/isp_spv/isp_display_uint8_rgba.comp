#version 450
// isp.display (float RGB out) — the display tensor is FLOAT-typed at runtime
// (MNN allocates Extra outputs as float regardless of the declared elemType),
// so the shader writes PLANAR FLOAT RGB [1,3,oh,ow] in the 0-255 display
// domain (gamma already applied upstream). The JNI float path (13.3c) packs
// this into the RGBA_8888 AHB.
//
// USER SPEC (downscale block): the actual fit+letterbox lives in
// isp.downscale; this display op is a format adapter (pack check only).
//
// Uniforms (binding 0): {W,H,gamma,pad} — W/H hot-swapped from the INPUT
//   tensor dims (gamma output [1,3,h,w] → tw=w, th=h).
// In:  float[1,3,h,w] NCHW planar RGB (0-255 display domain).
// Out: float[1,3,h,w] NCHW planar RGB (same values; clamp for safety).

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) buffer Uniforms {
    float width; float height; float gamma; float pad;
} u;

layout(set = 0, binding = 1) readonly  buffer InBuf  { float in_data[]; };
layout(set = 0, binding = 2) writeonly buffer OutBuf { float out_data[]; };

void main() {
    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;
    int w = int(u.width);
    int h = int(u.height);
    if (int(x) >= w || int(y) >= h) return;
    int idx = int(y) * w + int(x);
    int sz = w * h;
    for (int c = 0; c < 3; c++) {
        float v = in_data[c * sz + idx];
        out_data[c * sz + idx] = clamp(v, 0.0, 255.0);
    }
}
