#version 450
// isp.display (float RGB out) — the display tensor is FLOAT-typed at runtime
// (MNN allocates Extra outputs as float regardless of the declared elemType),
// so the shader writes PLANAR FLOAT RGB [1,3,oh,ow] in the 0-255 display
// domain (gamma already applied upstream). The JNI float path (13.3c) packs
// this into the RGBA_8888 AHB.
//
// USER SPEC (downscale block): the actual fit+letterbox lives in
// isp.downscale; this display op is a format adapter (pack check only).
//
// Uniforms (binding 0): {W,H,gamma,pad} — W/H hot-swapped from the INPUT
//   tensor dims (gamma output [1,3,h,w] → tw=w, th=h). gamma > 0 adds an
//   encode; gamma <= 0 keeps the [0,1] pixel, then the 0-255 scale applies.
// In:  float[1,3,h,w] NCHW planar RGB (0-255 display domain).
// Out: float[1,3,h,w] NCHW planar RGB (same values; clamp for safety).

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) buffer Uniforms {
    float width; float height; float gamma; float pad;
} u;

layout(set = 0, binding = 1) readonly  buffer InBuf  { float in_data[]; };
layout(set = 0, binding = 2) writeonly buffer OutBuf { float out_data[]; };

void main() {
    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;
    int w = int(u.width);
    int h = int(u.height);
    if (int(x) >= w || int(y) >= h) return;
    int idx = int(y) * w + int(x);
    int sz = w * h;
    float c0 = in_data[0 * sz + idx];
    float c1 = in_data[1 * sz + idx];
    float c2 = in_data[2 * sz + idx];

    // Pixel-wise domain decision (same rule the JNI float→RGBA8 path used):
    // a pixel already in the 0-255 domain is taken as-is, a [0,1] pixel is
    // scaled once. Deciding per channel would tint pixels that straddle it.
    if (max(c0, max(c1, c2)) <= 1.001) {
        c0 *= 255.0; c1 *= 255.0; c2 *= 255.0;
    }
    // Optional extra encode: gamma <= 0 is identity, which is what the main
    // chain passes because isp.gamma already encodes.
    // gamma == 1.0 is an identity encode, so skip the pow entirely (the main
    // chain already encoded in isp.gamma and feeds gamma = 1.0 here). This
    // saves 3 pow() calls per pixel, ~518k per 480x360 frame.
    float g = u.gamma;
    if (g > 0.0001f && abs(g - 1.0f) > 0.0001f) {
        float invg = 1.0 / g;
        c0 = 255.0 * pow(clamp(c0 / 255.0, 0.0, 1.0), invg);
        c1 = 255.0 * pow(clamp(c1 / 255.0, 0.0, 1.0), invg);
        c2 = 255.0 * pow(clamp(c2 / 255.0, 0.0, 1.0), invg);
    }
    out_data[0 * sz + idx] = clamp(c0, 0.0, 255.0);
    out_data[1 * sz + idx] = clamp(c1, 0.0, 255.0);
    out_data[2 * sz + idx] = clamp(c2, 0.0, 255.0);
}
