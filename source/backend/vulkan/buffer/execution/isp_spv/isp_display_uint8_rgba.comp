#version 450
// isp.display_uint8_rgba — format adapter: planar float RGB -> packed byte RGB.
//
// The display tensor is FLOAT-typed at runtime (MNN allocates Extra outputs as
// float regardless of the declared elemType), so this shader writes PLANAR
// FLOAT RGB [1,3,oh,ow] holding BYTE values (0-255); the JNI float path packs
// them into the RGBA_8888 AHB.
//
// SCALE — DECLARED, never guessed. Uniform (binding 0): {W, H, gamma, fullScale}
//   fullScale = the numeric full-scale of the INCOMING frame:
//       1.0        — the chain normalized (NormalizeBlock ran)      -> *255
//       1023 (etc) — normalization absent, native sensor/code units -> *255/1023
//   Either way the conversion is `value / fullScale * 255`, so one expression
//   covers both domains.
//
//   This replaces a per-pixel heuristic ("if max(r,g,b) <= 1.001 then *255")
//   which was a DISCONTINUITY at that boundary rather than a scale decision:
//   1.000 became 255 while 1.001 became ~1, so an un-normalized frame — whose
//   pixels legitimately sit in the tens or hundreds — had almost everything
//   divided down to black.
//
// gamma > 0 adds an extra encode (gamma == 1 is an identity encode and is
// skipped; the main chain already encodes in isp.gamma). gamma <= 0 also
// skips.
//
// In:  float[1,3,h,w] NCHW planar RGB, in `fullScale` units.
// Out: float[1,3,h,w] NCHW planar RGB, in byte units (0-255).

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) buffer Uniforms {
    float width;
    float height;
    float gamma;
    float fullScale;
} u;

layout(set = 0, binding = 1) readonly  buffer InBuf  { float in_data[]; };
layout(set = 0, binding = 2) writeonly buffer OutBuf { float out_data[]; };

void main() {
    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;
    int w = int(u.width);
    int h = int(u.height);
    if (int(x) >= w || int(y) >= h) return;
    int idx = int(y) * w + int(x);
    int sz = w * h;
    float c0 = in_data[0 * sz + idx];
    float c1 = in_data[1 * sz + idx];
    float c2 = in_data[2 * sz + idx];

    // Declared full scale -> bytes. Guard against a zero/absent uniform (an
    // unfed binding-0 leaves fullScale == 0, which would divide by zero): 1.0
    // is the normalized default and the safe assumption.
    float fs = u.fullScale;
    if (!(fs > 1e-6)) fs = 1.0;
    float toByte = 255.0 / fs;
    c0 *= toByte; c1 *= toByte; c2 *= toByte;

    // Optional extra encode over the byte-domain values.
    float g = u.gamma;
    if (g > 0.0001f && abs(g - 1.0f) > 0.0001f) {
        float invg = 1.0 / g;
        c0 = 255.0 * pow(clamp(c0 / 255.0, 0.0, 1.0), invg);
        c1 = 255.0 * pow(clamp(c1 / 255.0, 0.0, 1.0), invg);
        c2 = 255.0 * pow(clamp(c2 / 255.0, 0.0, 1.0), invg);
    }
    out_data[0 * sz + idx] = clamp(c0, 0.0, 255.0);
    out_data[1 * sz + idx] = clamp(c1, 0.0, 255.0);
    out_data[2 * sz + idx] = clamp(c2, 0.0, 255.0);
}
