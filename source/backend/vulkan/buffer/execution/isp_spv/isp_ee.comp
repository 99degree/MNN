#version 450
// isp.ee — edge enhancement: depthwise 3x3 unsharp conv, per RGB channel.
//
// This replaced an earlier stub that copied its input. The block's primitive form is
// `Conv(kernel=3x3, group=3)` with `pads=1`; this shader does the same maths
// directly, which removes a whole ONNX Conv from the fused path.
//
// Inputs (universal isp.* map):
//   binding 3 = frame      [1,3,H,W] planar RGB in [0,1]
//   binding 5 = KernelEeBuf [3,1,3,3] — one 3x3 kernel per channel
//   binding 6 = BiasEeBuf   [3]
// Output:
//   binding 4 = frame      [1,3,H,W] planar RGB
//
// Planar layout: pixel p of channel k lives at k*(W*H) + p.
//
// The default kernel is the block's own: centre 3.0, orthogonal neighbours
// -0.5, sum 1.0 so a flat field passes through unchanged.

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) buffer Uniforms {
    float width;
    float height;
    float pad0;
    float pad1;
} u;

layout(set = 0, binding = 3) readonly  buffer InBuf    { float in_data[]; };
layout(set = 0, binding = 4) writeonly buffer OutBuf   { float out_data[]; };
layout(set = 0, binding = 5) readonly  buffer KernelEe { float kernel[]; };
layout(set = 0, binding = 6) readonly  buffer BiasEe   { float bias[]; };

void main() {
    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;
    int w = int(u.width);
    int h = int(u.height);
    if (int(x) >= w || int(y) >= h) return;

    int plane = w * h;
    int p = int(y) * w + int(x);

    for (int c = 0; c < 3; ++c) {
        // Kernel for this channel: kernel[c*9 + ky*3 + kx].
        int kbase = c * 9;
        float acc = bias[c];
        for (int ky = -1; ky <= 1; ++ky) {
            int sy = int(y) + ky;
            // Replicate the edge pixel: `pads=1` in the conv pads with zeros,
            // which would darken borders. Clamping keeps the frame flat at the
            // boundary instead of introducing a dark rim.
            if (sy < 0) sy = 0;
            if (sy >= h) sy = h - 1;
            for (int kx = -1; kx <= 1; ++kx) {
                int sx = int(x) + kx;
                if (sx < 0) sx = 0;
                if (sx >= w) sx = w - 1;
                float s = in_data[c * plane + sy * w + sx];
                acc += s * kernel[kbase + (ky + 1) * 3 + (kx + 1)];
            }
        }
        out_data[c * plane + p] = clamp(acc, 0.0, 1.0);
    }
}
