#version 450
// isp.lsc_min — MINIMAL opset lens shading correction.
// 
// PROCEDURAL gain grid generation from minimal uniform parameters.
// NO large tensor inputs - all gain values computed on-the-fly.
// 
// Uniform parameters (binding 0):
//   k1, k2: radial polynomial coefficients (r^2, r^4 terms)
//   vcmNorm: normalized VCM position [0,1]
//   strength: LSC strength multiplier [0,1]
//   wh: frame width/height (hot-swapped per-frame)
//
// This is the MINIMAL opset variant - NO large tensor inputs.
// The 17x13x4 gain grid is computed per-pixel from the radial polynomial model.

#extension GL_EXT_scalar_block_layout : require

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) buffer LscParams {
    // wh MUST be at offset 0/1: the VulkanFuse ELEMENTWISE patch hot-swaps
    // W/H into the FIRST TWO floats of the binding-0 const buffer. With wh
    // at any other offset the shader reads wh=(0,0) → early-returns → the
    // output tensor is never written → downstream reads uninitialized memory.
    float width;        // hot-swapped from input tensor dims
    float height;       // hot-swapped from input tensor dims
    float k1;           // radial r^2 coefficient
    float k2;           // radial r^4 coefficient
    float vcmNorm;      // normalized VCM position [0,1]
    float strength;     // LSC strength multiplier [0,1]
    float pad0;
    float pad1;
    float pad2;
} p;

layout(set = 0, binding = 1, std430) readonly buffer FrameIn { float in_data[]; };
layout(set = 0, binding = 2, std430) writeonly buffer FrameOut { float out_data[]; };
// binding 3 = LSC_STRENGTH float[4] {k1, k2, vcmNorm, strength}, the SAME named
// tensor the controller drives. Kept OFF binding 0 on purpose: the ELEMENTWISE
// patch writes W/H into binding 0's first two floats every frame, so per-frame
// coefficients must not live there. When the tensor is unfed the values are 0
// and the gain collapses to exactly 1.0 (a documented passthrough).
layout(set = 0, binding = 3, std430) readonly buffer LscCoef { float coef[]; };

#define GRID_COLS 17
#define GRID_ROWS 13
#define GRID_CHANS 4

// Pre-computed center and max radius for radial model
const float cy = float(GRID_ROWS - 1) / 2.0;  // 6.0
const float cx = float(GRID_COLS - 1) / 2.0;  // 8.0
const float maxR = sqrt(cy * cy + cx * cx);   // 10.0

// Helper function to compute gain at grid index (row, col, chan) procedurally
float computeGain(int row, int col, int c) {
    float dy = (float(row) - 6.0) / 10.0;  // normalized [-0.6, 0.6]
    float dx = (float(col) - 8.0) / 10.0;  // normalized [-0.8, 0.8]
    float r2 = dx * dx + dy * dy;
    float r4 = r2 * r2;
    // Coefficients come from binding 3 (LSC_STRENGTH); 0 = passthrough.
    float k1 = coef[0];
    float k2 = coef[1];
    float vcmNorm = coef[2];
    float strength = coef[3];

    // Radial polynomial: f(r) = k1 * r^2 + k2 * r^4 + vcmNorm
    // Gain = f(r)^2 * strength (centered at 1.0)
    float f_r = k1 * r2 + k2 * r4 + vcmNorm;
    float gain = f_r * f_r;
    // Clamp to [0.8, 2.5] using conditional (GLSL 450 core doesn't have clamp)
    if (gain < 0.8) gain = 0.8;
    if (gain > 2.5) gain = 2.5;
    return 1.0 + (gain - 1.0) * strength;
}

void main() {
    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;
    uint w = uint(p.width);
    uint h = uint(p.height);
    if (x >= w || y >= h) return;

    // Unfed coefficients are all zero, so the stage is a no-op: copy this
    // pixel's four planes and leave. PER PIXEL — this invocation owns (x,y)
    // and writes ONLY that index. (An earlier revision looped over the whole
    // image here, so every one of the w*h invocations copied all 4 planes:
    // ~6.3e12 operations, which never completes and gets the process killed by
    // the GPU watchdog. That was the "3 frames then the app is gone" stall.)
    if (coef[3] <= 0.0) {
        uint n = w * h;
        uint idx = y * w + x;
        for (int c = 0; c < 4; ++c) {
            uint o = uint(c) * n + idx;
            out_data[o] = in_data[o];
        }
        return;
    }

    // Bayer RGGB quadrant selector -> 4 channels (R, G1, G2, B)
    uint chan = ((y & 1u) << 1) | (x & 1u);

    // Bilinear sampling of the PROCEDURALLY GENERATED 17x13 grid mapped over the full frame.
    float gx = (float(x) / float(w > 1u ? w - 1u : 1u)) * float(GRID_COLS - 1);  // 0..16
    float gy = (float(y) / float(h > 1u ? h - 1u : 1u)) * float(GRID_ROWS - 1);  // 0..12
    int ix0 = int(floor(gx));
    int iy0 = int(floor(gy));
    if (ix0 < 0) ix0 = 0;
    if (ix0 > GRID_COLS - 2) ix0 = GRID_COLS - 2;
    if (iy0 < 0) iy0 = 0;
    if (iy0 > GRID_ROWS - 2) iy0 = GRID_ROWS - 2;
    float tx = gx - float(ix0);
    float ty = gy - float(iy0);

    // Bilinear interpolation of procedurally generated 4 corners
    int c00 = (iy0 * GRID_COLS + ix0) * GRID_CHANS + int(chan);
    int c10 = (iy0 * GRID_COLS + (ix0 + 1)) * GRID_CHANS + int(chan);
    int c01 = ((iy0 + 1) * GRID_COLS + ix0) * GRID_CHANS + int(chan);
    int c11 = ((iy0 + 1) * GRID_COLS + (ix0 + 1)) * GRID_CHANS + int(chan);

    float g00 = computeGain(iy0, ix0, int(chan));
    float g10 = computeGain(iy0, ix0 + 1, int(chan));
    float g01 = computeGain(iy0 + 1, ix0, int(chan));
    float g11 = computeGain(iy0 + 1, ix0 + 1, int(chan));

    float g = g00 * (1.0 - tx) * (1.0 - ty)
            + g10 * tx * (1.0 - ty)
            + g01 * (1.0 - tx) * ty
            + g11 * tx * ty;

    // Plane-walk: the input is the [1,4,h,w] PLANAR CFA quad produced by
    // isp.cfa / isp.blc_min. The previous body indexed y*w+x (a SINGLE plane)
    // and wrote only plane 0, leaving the three chroma planes at whatever the
    // memory pool held — demosaic/ccm then consumed garbage. Multiply all four
    // planes by the same procedural gain (channels share the radial model; the
    // per-channel `chan` selector above only positions the grid sample).
    uint idx = y * w + x;
    uint plane = w * h;
    for (int c = 0; c < 4; ++c) {
        uint o = uint(c) * plane + idx;
        out_data[o] = in_data[o] * g;
    }
}