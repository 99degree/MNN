#version 450
// isp.tonelut — fused ToneLutBlock: 7-point LUT + contrast/brightness/gamma.
// Uniforms: {W, H, pad0, pad1} — W/H hot-swapped by `elementwise=1`.
// Bindings: 3 InBuf, 4 OutBuf; extras: 5 y0, 6..11 s0..s5,
//           12 contrast, 13 brightness, 14 inv_gamma.
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) buffer Uniforms {
    float width;
    float height;
    float pad0;
    float pad1;
} u;

layout(set = 0, binding = 3) readonly  buffer InBuf         { float in_data[]; };
layout(set = 0, binding = 4) writeonly buffer OutBuf        { float out_data[]; };
layout(set = 0, binding = 5) readonly  buffer Y0Buf         { float y0[]; };
layout(set = 0, binding = 6) readonly  buffer S0Buf         { float s0[]; };
layout(set = 0, binding = 7) readonly  buffer S1Buf         { float s1[]; };
layout(set = 0, binding = 8) readonly  buffer S2Buf         { float s2[]; };
layout(set = 0, binding = 9) readonly  buffer S3Buf         { float s3[]; };
layout(set = 0, binding = 10) readonly buffer S4Buf         { float s4[]; };
layout(set = 0, binding = 11) readonly buffer S5Buf         { float s5[]; };
layout(set = 0, binding = 12) readonly buffer ContrastBuf   { float contrast[]; };
layout(set = 0, binding = 13) readonly buffer BrightnessBuf { float brightness[]; };
layout(set = 0, binding = 14) readonly buffer InvGammaBuf   { float inv_gamma[]; };

const float SEG_W = 1.0 / 6.0;

void main() {
    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;
    int w = int(u.width);
    int h = int(u.height);
    if (int(x) >= w || int(y) >= h) return;

    int plane = w * h;
    int p = int(y) * w + int(x);
    float c = contrast[0];
    float b = brightness[0];
    float ig = max(inv_gamma[0], 1e-6);
    float acc0 = y0[0];
    float slopes[6] = float[6](s0[0], s1[0], s2[0], s3[0], s4[0], s5[0]);

    for (int ch = 0; ch < 3; ++ch) {
        float v = in_data[ch * plane + p];
        float lut = acc0;
        for (int i = 0; i < 6; ++i) {
            lut += clamp(v - float(i) * SEG_W, 0.0, SEG_W) * slopes[i];
        }
        v = clamp(lut * c + b, 0.0, 1.0);
        out_data[ch * plane + p] = pow(max(v, 1e-6), ig);
    }
}
