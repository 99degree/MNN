#version 450
// isp.bayer_wb — QUAD-PLANAR version: input/output are [1,4,H/2,W/2] NCHW
// (the CFA unpack's layout), one Bayer site per PLANE:
//   plane 0 = TL (R), plane 1 = TR (Gr), plane 2 = BL (Gb), plane 3 = BR (B).
// Gains (binding 0 uniforms, after W/H): gain_r, gain_gr, gain_gb, gain_b —
// one per plane, no pixel-parity select.
//
// The previous kernel was written for the packed single-plane raw image
// (gain from x/y parity); on the quad-planar layout it multiplied every plane
// by a parity-varying gain (average of the four), which measured as a uniform
// 2.35x on all planes in the planted-pattern window dump.
#extension GL_EXT_scalar_block_layout : require
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) buffer Uniforms {
    float width;    // quad W (hot-swapped from OUTPUT dims)
    float height;   // quad H
    float gain_r;
    float gain_gr;
    float gain_gb;
    float gain_b;
} u;

layout(set = 0, binding = 1) readonly  buffer InBuf  { float in_data[]; };
layout(set = 0, binding = 2) writeonly buffer OutBuf { float out_data[]; };

void main() {
    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;
    int w = int(u.width);
    int h = int(u.height);
    if (int(x) >= w || int(y) >= h) return;
    int idx = int(y) * w + int(x);
    uint plane = uint(w) * uint(h);

    out_data[idx]              = in_data[idx]              * u.gain_r;   // TL
    out_data[plane + idx]      = in_data[plane + idx]      * u.gain_gr;  // TR
    out_data[plane * 2u + idx] = in_data[plane * 2u + idx] * u.gain_gb;  // BL
    out_data[plane * 3u + idx] = in_data[plane * 3u + idx] * u.gain_b;   // BR
}
