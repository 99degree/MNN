#version 450
// isp.pipeline — the WHOLE ISP chain in ONE compute dispatch.
//
// Replaces the 12-op broken-down chain
//   crop -> normalize -> cfa -> blc_min -> lsc_min -> bayer_wb
//        -> demosaic_g2 -> ccm -> downscale -> gamma -> display
// with a single fused pass, so a failure is binary: either this op produced
// pixels (inference OK) or it did not (post-inference / readback).
//
// FORMULATION (output space)
//   The dispatch covers the OUTPUT grid (outW x outH). Each output pixel maps
//   back to its footprint in the raw plane and AREA-AVERAGES every CFA sample
//   inside it. That single step does what crop + normalize + cfa + demosaic +
//   downscale did together, and it is strictly better than the old chain: the
//   old isp.downscale used a 2-tap bilinear kernel over a large reduction, which
//   folded chroma back into the image (the "diffused colour"). An area filter
//   integrates the real footprint instead.
//
//   Per raw sample:  v = raw / sensorMax       <-- YES, the divide is required:
//                        the plane holds RAW SENSOR UNITS (measured 73..100 for
//                        a 10-bit sensor) while blc/wb/ccm arrive normalized.
//                        The 12-op chain does this in its `normalize` stage.
//                    v = (v - blc[plane])
//                    v *= lscGain ; v *= wb[plane]
//   Per RGB channel: acc[ch] += v * areaWeight        (ch: R=0 G=1 B=2)
//   Then:            rgb = acc / areasum ; rgb = ccm * rgb
//                    rgb = rgb + lift*(1-rgb)^2 ; rgb = pow(rgb, 1/gamma)
//                    out = 255 * rgb
//
// INPUTS — NAMED PER-COEFFICIENT TENSORS, one per coefficient, at bindings that
// mirror the broken-down opset's own blocks. Nothing is packed into a blob and
// nothing is duplicated: every coefficient below is the SAME named tensor
// (same TensorNames constant, same ParameterRegistry entry, same per-frame feed)
// that its standalone block already declares, so IspController's existing
// name-keyed 3A path drives this op exactly as it drives the per-op chain.
//
//   binding 0 = const SSBO float[8]. NOT read by this shader. It exists only so
//               VulkanFuse types the slot STORAGE_BUFFER and the descriptor
//               layout is complete (with no `const` attr, slot 0 keeps
//               descriptor type 0 = SAMPLER).
//   binding 1 = raw input plane        (frame in, RO)
//   binding 2 = display output         (frame out, WO)
//   binding 3 = DOWNSCALE_BLOCK/HW          float[4] {srcW, srcH, outW, outH}
//   binding 4 = BLC_PATTERN                 float[4] {R, Gr, Gb, B}  graph space
//   binding 5 = BAYERWBBLOCK/BAYER_GAINS    float[4] {R, Gr, Gb, B}
//   binding 6 = CCMBLOCK/CCM_MATRIX         float[9] row-major 3x3
//   binding 7 = TONE_CURVE/GAMMA_RECIP      float[1] 1/display_gamma
//   binding 8 = TONE_CURVE/SHADOW_LIFT      float[1] S-curve lift
//   binding 9 = DEMOSAIC_BLOCK/BAYER_PATTERN float[1] 0=RGGB 1=GRBG 2=GBRG 3=BGGR
//   binding 10 = NORMALIZE_BLOCK/SENSOR_MAX  float[1] raw-domain divisor
//   binding 11 = PIPELINEBLOCK/STAGES         float[1] STAGE MASK (bitfield)
//
// STAGE MASK — the "slim it down until the frame is recognizable" control.
// The op is a chain of independent stages; each is gated by one bit so a stage
// can be REMOVED one at a time and the point where the picture becomes
// recognizable identifies the stage that was destroying it. Bit set = stage
// RUNS. An all-zero mask is a bare area-averaged demosaic.
//
//   bit 0 DEMOSAIC    area-average the CFA footprint (else point-sample)
//   bit 1 NORMALIZE   divide the raw plane by sensorMax
//   bit 2 BLC         subtract the per-plane black level
//   bit 3 WB          apply the per-plane white balance
//   bit 4 CCM         apply the 3x3 colour matrix
//   bit 5 LIFT        S-curve shadow lift
//   bit 6 GAMMA       display encode pow(v, gamma_recip)
//   bit 7 LETTERBOX   fit+centre (else fill the output grid edge to edge)
//
// KNOWN GAP (recorded, not hidden): the fused op does NOT apply lens-shading
// correction. isp.lsc_min exists and its coefficients are now reachable via
// LSC_MIN_BLOCK/STRENGTH, so adding it here is a small, well-defined follow-up —
// it is deferred only because it would cost a 12th storage buffer for a stage
// whose strength currently defaults to 0, i.e. a no-op.
//
// NOTE ON SENSOR MAX: the raw plane is NOT divided here because BLC_PATTERN
// arrives ALREADY in graph space (ParameterRegistry divides the raw black level
// by sensorMax). This shader therefore performs no normalization at all — the
// normalization is what the *black-level* feed already encodes.
//
// CROP: the reference chain crops to min(16-aligned stride, stride) at start 0
// (PipelineConfigurator). That rule is fixed, so it is computed here instead of
// costing another input tensor.
//
// LAYOUT CONTRACT (2026-10-16): planar NCHW throughout. Matches isp.ccm,
// isp.gamma and the JNI float->RGBA8 readback path.

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) buffer Uniforms { float unused[8]; } u;
layout(set = 0, binding = 1) readonly  buffer InBuf   { float in_data[]; };
layout(set = 0, binding = 2) writeonly buffer OutBuf  { float out_data[]; };
layout(set = 0, binding = 3) readonly  buffer HwBuf   { float hw[]; };        // float[4]
layout(set = 0, binding = 4) readonly  buffer BlcBuf  { float blc[]; };       // float[4]
layout(set = 0, binding = 5) readonly  buffer WbBuf   { float wbGains[]; };   // float[4]
layout(set = 0, binding = 6) readonly  buffer CcmBuf  { float ccmMatrix[]; };  // float[9]
layout(set = 0, binding = 7) readonly  buffer GamBuf  { float gammaRecip[]; };// float[1]
layout(set = 0, binding = 8) readonly  buffer LiftBuf { float shadowLift[]; };// float[1]
layout(set = 0, binding = 9) readonly  buffer BayerBuf { float bayerPattern[]; };// float[1]
layout(set = 0, binding = 10) readonly buffer SensorMaxBuf { float sensorMax[]; };// float[1]
layout(set = 0, binding = 11) readonly buffer StageBuf { float stages[]; };   // float[1] bitfield

#define ST_DEMOSAIC  1
#define ST_NORMALIZE 2
#define ST_BLC       4
#define ST_WB        8
#define ST_CCM       16
#define ST_LIFT      32
#define ST_GAMMA     64
#define ST_LETTERBOX 128

// Default when the tensor is unfed (all-zero would silently drop everything):
// the FULL chain, so an un-updated caller behaves exactly as before.
#define ST_ALL       (ST_DEMOSAIC|ST_NORMALIZE|ST_BLC|ST_WB|ST_CCM|ST_LIFT|ST_GAMMA|ST_LETTERBOX)

// ── DOWNSCALE_BLOCK/HW index layout: {W, H, outW, outH} ──
#define H_SRC_W 0
#define H_SRC_H 1
#define H_OUT_W 2
#define H_OUT_H 3

// The crop rule mirrors PipelineConfigurator: 16-align DOWN, then clamp.
#define ALIGN16(v) (((v) / 16) * 16)

// Bayer parity (par = (y&1)<<1 | x&1, i.e. the quad site TL,TR,BL,BR) -> the
// CFA plane index whose BLC/WB entry applies to that site.
//
// isp.cfa packs plane p = site p, and BLC_PATTERN / BAYER_GAINS are indexed in
// that SAME plane order, so the site->plane step is an identity; what the Bayer
// pattern decides is which PLANE carries which COLOUR. This table is therefore
// the single place the pattern matters, and it is what removed the red/magenta
// cast on a GRBG sensor.
//
//   RGGB: TL=R   TR=Gr  BL=Gb  BR=B   -> colour per plane {R, Gr, Gb, B}
//   GRBG: TL=Gr  TR=R   BL=B   BR=Gb  -> plane 1 is R, plane 2 is B
//   GBRG: TL=Gb  TR=B   BL=R   BR=Gr  -> plane 2 is R, plane 1 is B
//   BGGR: TL=B   TR=Gb  BL=Gr  BR=R   -> plane 3 is R, plane 0 is B
int planeForColor(int par, int pat) {
    if (pat == 0) return par;                                     // 0,1,2,3
    if (pat == 1) return (par == 0) ? 1 : (par == 1) ? 0 : (par == 2) ? 3 : 2;
    if (pat == 2) return (par == 0) ? 2 : (par == 1) ? 3 : (par == 2) ? 0 : 1;
    return               (par == 0) ? 3 : (par == 1) ? 2 : (par == 2) ? 1 : 0;
}

// Colour of a CFA plane: 0=R, 1=G, 2=B. Gr and Gb both land on green.
int chanOfPlane(int plane) {
    return (plane == 1 || plane == 2) ? 1 : (plane == 0) ? 0 : 2;
}

float blcOf(int plane) {
    return (plane == 0) ? blc[0]
         : (plane == 1) ? blc[1]
         : (plane == 2) ? blc[2]
         : blc[3];
}

float wbOf(int plane) {
    return (plane == 0) ? wbGains[0]
         : (plane == 1) ? wbGains[1]
         : (plane == 2) ? wbGains[2]
         : wbGains[3];
}

void main() {
    uint xo = gl_GlobalInvocationID.x;
    uint yo = gl_GlobalInvocationID.y;

    int ow = int(hw[H_OUT_W]);
    int oh = int(hw[H_OUT_H]);
    if (ow < 1 || oh < 1) return;
    if (int(xo) >= ow || int(yo) >= oh) return;

    int sw = int(hw[H_SRC_W]);       // raw plane stride width
    int sh = int(hw[H_SRC_H]);
    if (sw < 2 || sh < 2) return;

    // Crop window (mirrors PipelineConfigurator's resolvedCrop); start 0.
    int cropW = ALIGN16(sw);
    if (cropW <= 0 || cropW > sw) cropW = sw;
    int cropH = sh;
    int startW = 0;
    int startH = 0;
    if (cropW < 2 || cropH < 2) return;

    int x = int(xo);
    int y = int(yo);

    // Stage mask. Unfed (0) means FULL — see ST_ALL. Read BEFORE the geometry
    // because LETTERBOX decides whether the fit/centre step runs at all.
    int stages = int(stages[0]);
    if (stages == 0) stages = ST_ALL;

    // ── FIT + LETTERBOX (identical geometry to isp.downscale) ──
    // With LETTERBOX off the content fills the output grid: useful when the
    // black bars themselves are suspected of confusing the readback.
    int cw, ch, offX, offY;
    if ((stages & ST_LETTERBOX) != 0) {
        float fitW = float(ow) / float(cropW);
        float fitH = float(oh) / float(cropH);
        float scale = min(fitW, fitH);
        cw = max(int(float(cropW) * scale + 0.5), 1);   // content W
        ch = max(int(float(cropH) * scale + 0.5), 1);   // content H
        offX = (ow - cw) / 2;
        offY = (oh - ch) / 2;
    } else {
        cw = ow; ch = oh; offX = 0; offY = 0;
    }

    int cx = x - offX;
    int cy = y - offY;
    int oplane = ow * oh;
    int oidx = y * ow + x;

    // Outside the content rect -> black letterbox / pillarbox.
    if (cx < 0 || cy < 0 || cx >= cw || cy >= ch) {
        out_data[oidx] = 0.0;
        out_data[oplane + oidx] = 0.0;
        out_data[2 * oplane + oidx] = 0.0;
        return;
    }

    // ── AREA FOOTPRINT in crop-local coordinates ──
    // Output pixel [cx,cx+1) x [cy,cy+1) maps to this exact source rectangle:
    // the area filter weights every source sample by how much of it the output
    // pixel actually covers. The OLD 2-tap bilinear could not represent this
    // footprint, which is what aliased chroma back into the image.
    float sx0 = float(cx)     * float(cropW) / float(cw);
    float sx1 = float(cx + 1) * float(cropW) / float(cw);
    float sy0 = float(cy)     * float(cropH) / float(ch);
    float sy1 = float(cy + 1) * float(cropH) / float(ch);

    int ix0 = int(floor(sx0));
    int ix1 = int(ceil(sx1));
    int iy0 = int(floor(sy0));
    int iy1 = int(ceil(sy1));

    int pat = int(bayerPattern[0]);
    if (pat < 0) pat = 0;
    if (pat > 3) pat = 3;

    // Raw-domain divisor. The uploaded plane is raw sensor units; every
    // coefficient below is normalized, so this is the stage that makes them
    // commensurate. 1.0 fallback keeps a legacy caller working.
    float invSensorMax = 1.0 / max(sensorMax[0], 1e-6);

    float accR = 0.0, accG = 0.0, accB = 0.0, wsum = 0.0;

    for (int iy = iy0; iy < iy1; iy++) {
        // Overlap of this source row with the footprint on the y axis.
        float wy = min(sy1, float(iy + 1)) - max(sy0, float(iy));
        if (wy <= 0.0) continue;
        int ry = startH + iy;
        if (ry < 0 || ry >= sh) continue;

        for (int ix = ix0; ix < ix1; ix++) {
            float wx = min(sx1, float(ix + 1)) - max(sx0, float(ix));
            if (wx <= 0.0) continue;
            int rx = startW + ix;
            if (rx < 0 || rx >= sw) continue;

            float w = wx * wy;
            int par   = ((ry & 1) << 1) | (rx & 1);
            int plane = planeForColor(par, pat);
            int chn   = chanOfPlane(plane);
            // DEMOSAIC off -> the footprint becomes a point sample of the
            // nearest source pixel, which isolates whether the AREA AVERAGING
            // is what spreads colour. With it on, every sample in the footprint
            // contributes its area weight.
            if ((stages & ST_DEMOSAIC) == 0 && !(ix == ix0 && iy == iy0)) continue;

            float v = in_data[ry * sw + rx];
            if ((stages & ST_NORMALIZE) != 0) v *= invSensorMax;
            if ((stages & ST_BLC) != 0)       v -= blcOf(plane);
            if ((stages & ST_WB) != 0)        v *= wbOf(plane);

            if (chn == 0)      accR += v * w;
            else if (chn == 1) accG += v * w;
            else               accB += v * w;
            wsum += w;
        }
    }

    if (wsum <= 0.0) {
        out_data[oidx] = 0.0;
        out_data[oplane + oidx] = 0.0;
        out_data[2 * oplane + oidx] = 0.0;
        return;
    }
    float r = accR / wsum;
    float g = accG / wsum;
    float b = accB / wsum;

    // ── CCM (row-major 3x3, the SAME CCMBLOCK/CCM_MATRIX CcmBlock reads) ──
    float cr = r, cg = g, cb = b;
    if ((stages & ST_CCM) != 0) {
        cr = ccmMatrix[0] * r + ccmMatrix[1] * g + ccmMatrix[2] * b;
        cg = ccmMatrix[3] * r + ccmMatrix[4] * g + ccmMatrix[5] * b;
        cb = ccmMatrix[6] * r + ccmMatrix[7] * g + ccmMatrix[8] * b;
    }

    // ── S-curve shadow lift (same form as isp_gamma's binding 4) ──
    float lift = ((stages & ST_LIFT) != 0) ? shadowLift[0] : 0.0;
    if (lift != 0.0) {
        cr = cr + lift * (1.0 - cr) * (1.0 - cr);
        cg = cg + lift * (1.0 - cg) * (1.0 - cg);
        cb = cb + lift * (1.0 - cb) * (1.0 - cb);
    }

    // ── Gamma encode ──
    // TONE_CURVE/GAMMA_RECIP is 1/display_gamma (the encoded exponent is its
    // reciprocal), exactly as isp.gamma consumes the same tensor.
    float recip = max(gammaRecip[0], 1e-4);
    float gam = 1.0 / recip;
    float invg = recip;                       // pow(v, 1/gam) == pow(v, recip)
    if ((stages & ST_GAMMA) != 0 && gam > 0.0001) {
        cr = pow(clamp(cr, 0.0, 1.0), invg);
        cg = pow(clamp(cg, 0.0, 1.0), invg);
        cb = pow(clamp(cb, 0.0, 1.0), invg);
    } else {
        cr = clamp(cr, 0.0, 1.0);
        cg = clamp(cg, 0.0, 1.0);
        cb = clamp(cb, 0.0, 1.0);
    }

    // The display tensor is the 0-255 float domain (DisplayBlock's contract;
    // the JNI float path packs it into the RGBA_8888 AHB).
    out_data[oidx]              = cr * 255.0;
    out_data[oplane + oidx]     = cg * 255.0;
    out_data[2 * oplane + oidx] = cb * 255.0;
}
