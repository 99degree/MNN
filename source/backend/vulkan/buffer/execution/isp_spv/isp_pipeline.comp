#version 450
// isp.pipeline — the WHOLE ISP chain in ONE compute dispatch.
//
// Replaces the 12-op broken-down chain
//   crop -> normalize -> cfa -> blc_min -> lsc_min -> bayer_wb
//        -> demosaic_g2 -> ccm -> downscale -> gamma -> display
// with a single fused pass, so a failure is binary: either this op produced
// pixels (inference OK) or it did not (post-inference / readback).
//
// FORMULATION (output space)
//   The dispatch covers the OUTPUT grid (outW x outH). Each output pixel maps
//   back to its footprint in the raw plane and AREA-AVERAGES every CFA sample
//   inside it. That single step does what crop + normalize + cfa + demosaic +
//   downscale did together, and it is strictly better than the old chain: the
//   old isp.downscale used a 2-tap bilinear kernel over a 5.4x reduction, which
//   folded chroma back into the image (the "diffused colour"). An area filter
//   integrates the real footprint instead.
//
//   Per raw sample:  v = raw/sensorMax ; v = (v - blc[plane]) * blcGain
//                    v *= lscGain ; v *= wb[plane]
//   Per RGB channel: acc[ch] += v * areaWeight        (ch: R=0 G=1 B=2)
//   Then:            rgb = acc / areasum ; rgb = ccm * rgb
//                    rgb = rgb + lift*(1-rgb)^2 ; rgb = pow(rgb, 1/gamma)
//                    out = 255 * rgb
//
// BINDINGS (the verified isp.* positional convention)
//   binding 0 = const SSBO, DECLARED but never read. It exists only so
//               VulkanFuse's descriptor layout types the slot as
//               STORAGE_BUFFER — with no `const` attr that slot keeps
//               descriptor type 0 (SAMPLER) and the layout is invalid.
//               ALL geometry and coefficients therefore arrive on binding 3,
//               so this op needs NO const hot-swap patch at all.
//   binding 1 = raw input plane [1,1,H_src,W_src] (RO)
//   binding 2 = display output [1,3,outH,outW] planar float, 0-255 domain (WO)
//   binding 3 = PIPELINE_PARAMS float[N] — ONE per-frame tensor carrying every
//               coefficient. See the index block below (and TensorNames.java,
//               which is the single source of truth for the layout).
//
// LAYOUT CONTRACT (2026-10-16): planar NCHW throughout. Matches isp.ccm,
// isp.gamma and the JNI float->RGBA8 readback path.

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) buffer Uniforms {
    float pad0; float pad1; float pad2; float pad3;
    float pad4; float pad5; float pad6; float pad7;
} u;

layout(set = 0, binding = 1) readonly  buffer InBuf    { float in_data[]; };
layout(set = 0, binding = 2) writeonly buffer OutBuf   { float out_data[]; };
layout(set = 0, binding = 3) readonly  buffer ParamBuf { float params[]; };

// ── PIPELINE_PARAMS index layout (mirrors TensorNames.java) ──
#define P_SRC_W        0
#define P_SRC_H        1
#define P_OUT_W        2
#define P_OUT_H        3
#define P_CROP_W       4
#define P_CROP_H       5
#define P_START_W      6
#define P_START_H      7
#define P_SENSOR_MAX   8
#define P_BLC_R        9
#define P_BLC_GR      10
#define P_BLC_GB      11
#define P_BLC_B       12
#define P_LSC_K1      13
#define P_LSC_K2      14
#define P_LSC_VCM     15
#define P_LSC_STRENGTH 16
#define P_WB_R        17
#define P_WB_G1       18
#define P_WB_G2       19
#define P_WB_B        20
#define P_BAYER       21
#define P_CCM         22   // 22..30, row-major 3x3
#define P_GAMMA       31
#define P_LIFT        32
#define P_BLC_GAIN    33

// CFA site (par = (y&1)<<1 | x&1) -> CFA plane index [0=R, 1=Gr, 2=Gb, 3=B].
// The plane ORDER is what the Bayer pattern defines (isp.cfa writes plane p =
// channel p of the quad), so this table is what makes the pattern matter.
int planeOf(int par, int pat) {
    if (pat == 0) {                       // RGGB: TL=R TR=Gr BL=Gb BR=B
        return par;                       // 0,1,2,3
    } else if (pat == 1) {                // GRBG: TL=Gr TR=R BL=B BR=Gb
        return (par == 0) ? 1 : (par == 1) ? 0 : (par == 2) ? 3 : 2;
    } else if (pat == 2) {                // GBRG: TL=Gb TR=B BL=R BR=Gr
        return (par == 0) ? 2 : (par == 1) ? 3 : (par == 2) ? 0 : 1;
    }                                     // BGGR: TL=B TR=Gb BL=Gr BR=R
    return (par == 0) ? 3 : (par == 1) ? 2 : (par == 2) ? 1 : 0;
}

// CFA plane -> RGB channel. Gr and Gb both land on green.
int chanOfPlane(int plane) {
    return (plane == 0) ? 0 : (plane == 1) ? 1 : (plane == 2) ? 1 : 2;
}

float blcOf(int plane) {
    return (plane == 0) ? params[P_BLC_R]
         : (plane == 1) ? params[P_BLC_GR]
         : (plane == 2) ? params[P_BLC_GB]
         : params[P_BLC_B];
}

float wbOf(int plane) {
    return (plane == 0) ? params[P_WB_R]
         : (plane == 1) ? params[P_WB_G1]
         : (plane == 2) ? params[P_WB_G2]
         : params[P_WB_B];
}

// Procedural radial lens-shading gain, evaluated continuously at the raw pixel.
// Same model as isp_lsc_min (k1*r^2 + k2*r^4 + vcm, squared, clamped, then
// blended by `strength`), so strength == 0 is an exact passthrough.
float lscGain(int ix, int iy, int cropW, int cropH) {
    float strength = params[P_LSC_STRENGTH];
    if (strength <= 0.0) return 1.0;
    // crop-local normalized coords in [-1, 1]
    float nx = (float(ix) / float(max(cropW - 1, 1))) * 2.0 - 1.0;
    float ny = (float(iy) / float(max(cropH - 1, 1))) * 2.0 - 1.0;
    float r2 = nx * nx + ny * ny;
    float r4 = r2 * r2;
    float fr = params[P_LSC_K1] * r2 + params[P_LSC_K2] * r4 + params[P_LSC_VCM];
    float g = fr * fr;
    if (g < 0.8) g = 0.8;
    if (g > 2.5) g = 2.5;
    return 1.0 + (g - 1.0) * strength;
}

void main() {
    uint xo = gl_GlobalInvocationID.x;
    uint yo = gl_GlobalInvocationID.y;

    int ow = int(params[P_OUT_W]);
    int oh = int(params[P_OUT_H]);
    if (ow < 1 || oh < 1) return;
    if (int(xo) >= ow || int(yo) >= oh) return;

    int sw = int(params[P_SRC_W]);       // raw plane stride width
    int sh = int(params[P_SRC_H]);
    if (sw < 2 || sh < 2) return;

    // Crop window inside the raw plane (what isp.crop used to do).
    // <=0 means "no crop" and is resolved to the full plane.
    int cropW = int(params[P_CROP_W]);
    int cropH = int(params[P_CROP_H]);
    int startW = int(params[P_START_W]);
    int startH = int(params[P_START_H]);
    if (cropW <= 0) { cropW = sw; startW = 0; }
    if (cropH <= 0) { cropH = sh; startH = 0; }
    if (startW < 0) startW = 0;
    if (startH < 0) startH = 0;
    if (startW + cropW > sw) cropW = sw - startW;
    if (startH + cropH > sh) cropH = sh - startH;
    if (cropW < 2 || cropH < 2) return;

    int x = int(xo);
    int y = int(yo);

    // ── FIT + LETTERBOX (identical geometry to isp.downscale) ──
    float fitW = float(ow) / float(cropW);
    float fitH = float(oh) / float(cropH);
    float scale = min(fitW, fitH);
    int cw = max(int(float(cropW) * scale + 0.5), 1);   // content W
    int ch = max(int(float(cropH) * scale + 0.5), 1);   // content H
    int offX = (ow - cw) / 2;
    int offY = (oh - ch) / 2;

    int cx = x - offX;
    int cy = y - offY;
    int oplane = ow * oh;
    int oidx = y * ow + x;

    // Outside the content rect -> black letterbox / pillarbox.
    if (cx < 0 || cy < 0 || cx >= cw || cy >= ch) {
        out_data[oidx] = 0.0;
        out_data[oplane + oidx] = 0.0;
        out_data[2 * oplane + oidx] = 0.0;
        return;
    }

    // ── AREA FOOTPRINT in crop-local coordinates ──
    // Output pixel [cx,cx+1) x [cy,cy+1) maps to this exact source rectangle:
    // the area filter weights every source sample by how much of it the output
    // pixel actually covers. The OLD 2-tap bilinear could not represent this
    // footprint, which is what aliased chroma back into the image.
    float sx0 = float(cx)     * float(cropW) / float(cw);
    float sx1 = float(cx + 1) * float(cropW) / float(cw);
    float sy0 = float(cy)     * float(cropH) / float(ch);
    float sy1 = float(cy + 1) * float(cropH) / float(ch);

    int ix0 = int(floor(sx0));
    int ix1 = int(ceil(sx1));
    int iy0 = int(floor(sy0));
    int iy1 = int(ceil(sy1));

    float invSensorMax = 1.0 / max(params[P_SENSOR_MAX], 1e-6);
    float blcGain = params[P_BLC_GAIN];
    int pat = int(params[P_BAYER]);
    if (pat < 0) pat = 0;
    if (pat > 3) pat = 3;

    float accR = 0.0, accG = 0.0, accB = 0.0, wsum = 0.0;

    for (int iy = iy0; iy < iy1; iy++) {
        // Overlap of this source row with the footprint on the y axis.
        float wy = min(sy1, float(iy + 1)) - max(sy0, float(iy));
        if (wy <= 0.0) continue;
        int ry = startH + iy;
        if (ry < 0 || ry >= sh) continue;

        for (int ix = ix0; ix < ix1; ix++) {
            float wx = min(sx1, float(ix + 1)) - max(sx0, float(ix));
            if (wx <= 0.0) continue;
            int rx = startW + ix;
            if (rx < 0 || rx >= sw) continue;

            float w = wx * wy;
            int plane = planeOf(((ry & 1) << 1) | (rx & 1), pat);
            int chn   = chanOfPlane(plane);

            float v = in_data[ry * sw + rx] * invSensorMax;
            v = (v - blcOf(plane)) * blcGain;
            v *= lscGain(ix, iy, cropW, cropH);
            v *= wbOf(plane);

            if (chn == 0)      accR += v * w;
            else if (chn == 1) accG += v * w;
            else               accB += v * w;
            wsum += w;
        }
    }

    if (wsum <= 0.0) {
        out_data[oidx] = 0.0;
        out_data[oplane + oidx] = 0.0;
        out_data[2 * oplane + oidx] = 0.0;
        return;
    }
    float r = accR / wsum;
    float g = accG / wsum;
    float b = accB / wsum;

    // ── CCM (row-major 3x3) ──
    float cr = params[P_CCM + 0] * r + params[P_CCM + 1] * g + params[P_CCM + 2] * b;
    float cg = params[P_CCM + 3] * r + params[P_CCM + 4] * g + params[P_CCM + 5] * b;
    float cb = params[P_CCM + 6] * r + params[P_CCM + 7] * g + params[P_CCM + 8] * b;

    // ── S-curve shadow lift (same form as isp_gamma's binding 4) ──
    float lift = params[P_LIFT];
    if (lift != 0.0) {
        cr = cr + lift * (1.0 - cr) * (1.0 - cr);
        cg = cg + lift * (1.0 - cg) * (1.0 - cg);
        cb = cb + lift * (1.0 - cb) * (1.0 - cb);
    }

    // ── Gamma encode: out = pow(clamp(v,0,1), 1/gamma) ──
    float gam = params[P_GAMMA];
    if (gam > 0.0001) {
        float invg = 1.0 / gam;
        cr = pow(clamp(cr, 0.0, 1.0), invg);
        cg = pow(clamp(cg, 0.0, 1.0), invg);
        cb = pow(clamp(cb, 0.0, 1.0), invg);
    } else {
        cr = clamp(cr, 0.0, 1.0);
        cg = clamp(cg, 0.0, 1.0);
        cb = clamp(cb, 0.0, 1.0);
    }

    // The display tensor is the 0-255 float domain (DisplayBlock's contract;
    // the JNI float path packs it into the RGBA_8888 AHB).
    out_data[oidx]              = cr * 255.0;
    out_data[oplane + oidx]     = cg * 255.0;
    out_data[2 * oplane + oidx] = cb * 255.0;
}
