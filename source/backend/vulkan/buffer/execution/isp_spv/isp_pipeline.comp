#version 450
// isp.pipeline — the WHOLE ISP chain in ONE compute dispatch.
//
// Replaces the 12-op broken-down chain
//   crop -> normalize -> cfa -> blc_min -> lsc_min -> bayer_wb
//        -> demosaic_g2 -> ccm -> downscale -> gamma -> display
// with a single fused pass, so a failure is binary: either this op produced
// pixels (inference OK) or it did not (post-inference / readback).
//
// FORMULATION (output space)
//   The dispatch covers the OUTPUT grid (outW x outH). Each output pixel maps
//   back to its footprint in the raw plane and AREA-AVERAGES every CFA sample
//   inside it. That single step does what crop + normalize + cfa + demosaic +
//   downscale did together, and it is strictly better than the old chain: the
//   old isp.downscale used a 2-tap bilinear kernel over a large reduction, which
//   folded chroma back into the image (the "diffused colour"). An area filter
//   integrates the real footprint instead.
//
//   Per raw sample:  v = raw / sensorMax       <-- YES, the divide is required:
//                        the plane holds RAW SENSOR UNITS (measured 73..100 for
//                        a 10-bit sensor) while blc/wb/ccm arrive normalized.
//                        The 12-op chain does this in its `normalize` stage.
//                    v = (v - blc[plane])
//                    v *= lscGain ; v *= wb[plane]
//   Per RGB channel: acc[ch] += v * areaWeight        (ch: R=0 G=1 B=2)
//   Then:            rgb = acc / areasum ; rgb = ccm * rgb
//                    rgb = rgb + lift*(1-rgb)^2 ; rgb = pow(rgb, 1/gamma)
//                    out = 255 * rgb
//
// INPUTS — NAMED PER-COEFFICIENT TENSORS, one per coefficient, at bindings that
// mirror the broken-down opset's own blocks. Nothing is packed into a blob and
// nothing is duplicated: every coefficient below is the SAME named tensor
// (same TensorNames constant, same ParameterRegistry entry, same per-frame feed)
// that its standalone block already declares, so IspController's existing
// name-keyed 3A path drives this op exactly as it drives the per-op chain.
//
//   binding 0 = const SSBO float[8]. NOT read by this shader. It exists only so
//               VulkanFuse types the slot STORAGE_BUFFER and the descriptor
//               layout is complete (with no `const` attr, slot 0 keeps
//               descriptor type 0 = SAMPLER).
//   binding 1 = raw input plane        (frame in, RO)
//   binding 2 = display output         (frame out, WO)
//   binding 3 = DOWNSCALE_BLOCK/HW          float[4] {srcW, srcH, outW, outH}
//   binding 4 = BLC_PATTERN                 float[4] {R, Gr, Gb, B}  graph space
//   binding 5 = BAYERWBBLOCK/BAYER_GAINS    float[4] {R, Gr, Gb, B}
//   binding 6 = CCMBLOCK/CCM_MATRIX         float[9] row-major 3x3
//   binding 7 = TONE_CURVE/GAMMA_RECIP      float[1] 1/display_gamma
//   binding 8 = TONE_CURVE/SHADOW_LIFT      float[1] S-curve lift
//   binding 9 = DEMOSAIC_BLOCK/BAYER_PATTERN float[1] 0=RGGB 1=GRBG 2=GBRG 3=BGGR
//   binding 10 = NORMALIZE_BLOCK/SENSOR_MAX  float[1] raw-domain divisor
//   binding 11 = PIPELINEBLOCK/STAGES         float[1] STAGE MASK (bitfield)
//
// STAGE MASK — the "slim it down until the frame is recognizable" control.
// The op is a chain of independent stages; each is gated by one bit so a stage
// can be REMOVED one at a time and the point where the picture becomes
// recognizable identifies the stage that was destroying it. Bit set = stage
// RUNS. An all-zero mask is a bare area-averaged demosaic.
//
//   bit 0 DEMOSAIC    area-average the CFA footprint (else point-sample)
//   bit 1 NORMALIZE   divide the raw plane by sensorMax
//   bit 2 BLC         subtract the per-plane black level
//   bit 3 WB          apply the per-plane white balance
//   bit 4 CCM         apply the 3x3 colour matrix
//   bit 5 LIFT        S-curve shadow lift
//   bit 6 GAMMA       display encode pow(v, gamma_recip)
//   bit 7 LETTERBOX   fit+centre (else fill the output grid edge to edge)
//   bit 8 DOWNSCALE   1:1 CENTRE CROP instead of the scaled mapping.
//                     This is the missing "downscale" stage: the op is ALWAYS
//                     reducing (the source is 2592x1944 and the output 480x360,
//                     a 5.4x reduction), and that reduction is the prime suspect
//                     for "no longer looks like the source". With this bit OFF
//                     the op takes the centre outW x outH pixels of the source
//                     and maps them 1:1, so no resampling happens at all.
//
// KNOWN GAP (recorded, not hidden): the fused op does NOT apply lens-shading
// correction. isp.lsc_min exists and its coefficients are now reachable via
// LSC_MIN_BLOCK/STRENGTH, so adding it here is a small, well-defined follow-up —
// it is deferred only because it would cost a 12th storage buffer for a stage
// whose strength currently defaults to 0, i.e. a no-op.
//
// NOTE ON SENSOR MAX: the raw plane is NOT divided here because BLC_PATTERN
// arrives ALREADY in graph space (ParameterRegistry divides the raw black level
// by sensorMax). This shader therefore performs no normalization at all — the
// normalization is what the *black-level* feed already encodes.
//
// CROP: the reference chain crops to min(16-aligned stride, stride) at start 0
// (PipelineConfigurator). That rule is fixed, so it is computed here instead of
// costing another input tensor.
//
// LAYOUT CONTRACT (2026-10-16): planar NCHW throughout. Matches isp.ccm,
// isp.gamma and the JNI float->RGBA8 readback path.

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) buffer Uniforms { float unused[8]; } u;
layout(set = 0, binding = 3) readonly  buffer InBuf   { float in_data[]; };

// ── binding 1: DEBUG TAP ────────────────────────────────────────────────────
// float[64x64] snapshot of THIS op's OUTPUT, written once per dispatch by thread
// (0,0). FIXED 64x64 whatever the frame size, header at offset 0 and payload at
// DBG_OFF, so a reader needs no per-op layout knowledge:
//   dbg[0]=DBG_SCHEMA dbg[1]=out element count dbg[2]=W dbg[3]=H dbg[4]=planes
// All-zero means the op never ran.
layout(set = 0, binding = 1) writeonly buffer DebugBuf { float dbg[]; };
#define DBG_SCHEMA 2
#define DBG_OFF    64
#define DBG_W      64
#define DBG_H      64

// ── binding 2: CONFIG ───────────────────────────────────────────────────────
//   cfg[0] >= 0.5   BYPASS: copy the input straight to the output, no math.
//                   DEFAULT (unfed / 0) = normal behaviour, so a model built
//                   before this binding existed is unaffected.
//   cfg[1]          plane count of this op's output, used by the bypass copy
//                   (a GLSL buffer has no length to derive it from).
//   cfg[2..]        reserved for THIS op's own switches. This is the single
//                   forward-looking field the design reserves per op.
layout(set = 0, binding = 2) readonly buffer ConfigBuf { float cfg[]; };

layout(set = 0, binding = 4) buffer OutBuf { float out_data[]; };
layout(set = 0, binding = 5) readonly  buffer HwBuf   { float hw[]; };        // float[4]
layout(set = 0, binding = 6) readonly  buffer BlcBuf  { float blc[]; };       // float[4]
layout(set = 0, binding = 7) readonly  buffer WbBuf   { float wbGains[]; };   // float[4]
layout(set = 0, binding = 8) readonly  buffer CcmBuf  { float ccmMatrix[]; };  // float[9]
layout(set = 0, binding = 9) readonly  buffer GamBuf  { float gammaRecip[]; };// float[1]
layout(set = 0, binding = 10) readonly  buffer LiftBuf { float shadowLift[]; };// float[1]
layout(set = 0, binding = 11) readonly  buffer BayerBuf { float bayerPattern[]; };// float[1]
layout(set = 0, binding = 12) readonly buffer SensorMaxBuf { float sensorMax[]; };// float[1]
layout(set = 0, binding = 13) readonly buffer StageBuf { float stages[]; };   // float[1] bitfield
// ── tail-stage coefficients ─────────────────────────────────────────────
// Same rule as every other coefficient here: one named tensor per value, at a
// binding of its own, fed per frame by the engine. Nothing is packed into a blob,
// so a stage can be switched on and fed without disturbing the others.
layout(set = 0, binding = 14) readonly buffer SatBuf    { float saturation[]; };   // float[1] chroma scale
layout(set = 0, binding = 15) readonly buffer DpcThrBuf { float dpcThreshold[]; }; // float[1] normalized distance
layout(set = 0, binding = 16) readonly buffer LscBuf    { float lscGrid[]; };      // float[17*13*4]
#define LSC_NX 17
#define LSC_NY 13

#define ST_DEMOSAIC  1
#define ST_NORMALIZE 2
#define ST_BLC       4
#define ST_WB        8
#define ST_CCM       16
#define ST_LIFT      32
#define ST_GAMMA     64
#define ST_LETTERBOX 128
// NOTE: bit 8 is INVERTED relative to the others — see ST_NOSCALE.
#define ST_NOSCALE   256
// ── stages the RGB/head chain needs, added one bit each ─────────────────
#define ST_SATURATION 512     ///< luma-preserving chroma scale (isp.saturation)
#define ST_DPC        1024    ///< bad-pixel correction, before the footprint sum
#define ST_LSC        2048    ///< lens shading gain, on the raw site
// Bit 12 changes the OUTPUT SCALE rather than adding work: with it set the
// output is 0..1 (divide by the white level), without it 0..255. softisp's
// planar-RGB consumers — probe means, the AHB preview's ×255 — all assume 0..1,
// while the original 0-255 contract assumed a display buffer. It has to be a
// bit for the same reason the others are: the same op serves both.
#define ST_LEVELS     4096    ///< emit 0..1 (else 0..255)

// Default when the tensor is unfed (all-zero would silently drop everything):
// the FULL chain, so an un-updated caller behaves exactly as before.
#define ST_ALL       (ST_DEMOSAIC|ST_NORMALIZE|ST_BLC|ST_WB|ST_CCM|ST_LIFT|ST_GAMMA|ST_LETTERBOX|ST_SATURATION|ST_DPC|ST_LSC|ST_LEVELS)

// ── DOWNSCALE_BLOCK/HW index layout: {W, H, outW, outH} ──
#define H_SRC_W 0
#define H_SRC_H 1
#define H_OUT_W 2
#define H_OUT_H 3

// The crop rule mirrors PipelineConfigurator: 16-align DOWN, then clamp.
#define ALIGN16(v) (((v) / 16) * 16)

// Bayer parity (par = (y&1)<<1 | x&1, i.e. the quad site TL,TR,BL,BR) -> the
// CFA plane index whose BLC/WB entry applies to that site.
//
// isp.cfa packs plane p = site p, and BLC_PATTERN / BAYER_GAINS are indexed in
// that SAME plane order, so the site->plane step is an identity; what the Bayer
// pattern decides is which PLANE carries which COLOUR. This table is therefore
// the single place the pattern matters, and it is what removed the red/magenta
// cast on a GRBG sensor.
//
//   RGGB: TL=R   TR=Gr  BL=Gb  BR=B   -> colour per plane {R, Gr, Gb, B}
//   GRBG: TL=Gr  TR=R   BL=B   BR=Gb  -> plane 1 is R, plane 2 is B
//   GBRG: TL=Gb  TR=B   BL=R   BR=Gr  -> plane 2 is R, plane 1 is B
//   BGGR: TL=B   TR=Gb  BL=Gr  BR=R   -> plane 3 is R, plane 0 is B
int planeForColor(int par, int pat) {
    if (pat == 0) return par;                                     // 0,1,2,3
    if (pat == 1) return (par == 0) ? 1 : (par == 1) ? 0 : (par == 2) ? 3 : 2;
    if (pat == 2) return (par == 0) ? 2 : (par == 1) ? 3 : (par == 2) ? 0 : 1;
    return               (par == 0) ? 3 : (par == 1) ? 2 : (par == 2) ? 1 : 0;
}

// Colour of a CFA plane: 0=R, 1=G, 2=B. Gr and Gb both land on green.
int chanOfPlane(int plane) {
    return (plane == 1 || plane == 2) ? 1 : (plane == 0) ? 0 : 2;
}

float blcOf(int plane) {
    return (plane == 0) ? blc[0]
         : (plane == 1) ? blc[1]
         : (plane == 2) ? blc[2]
         : blc[3];
}

float wbOf(int plane) {
    return (plane == 0) ? wbGains[0]
         : (plane == 1) ? wbGains[1]
         : (plane == 2) ? wbGains[2]
         : wbGains[3];
}

// Lens shading: bilinear sample of the 17x13x4 grid, indexed by the CFA plane so
// one grid serves all four Bayer sites.
float lscOf(int plane, int rx, int ry, int sw, int sh) {
    float fx = clamp(float(rx) * float(LSC_NX - 1) / max(float(sw - 1), 1.0), 0.0, float(LSC_NX - 1));
    float fy = clamp(float(ry) * float(LSC_NY - 1) / max(float(sh - 1), 1.0), 0.0, float(LSC_NY - 1));
    int x0 = int(fx), y0 = int(fy);
    int x1 = min(x0 + 1, LSC_NX - 1), y1 = min(y0 + 1, LSC_NY - 1);
    float wx = fx - float(x0), wy = fy - float(y0);
    int p4 = min(max(plane, 0), 3);
    float g00 = lscGrid[(y0 * LSC_NX + x0) * 4 + p4];
    float g10 = lscGrid[(y0 * LSC_NX + x1) * 4 + p4];
    float g01 = lscGrid[(y1 * LSC_NX + x0) * 4 + p4];
    float g11 = lscGrid[(y1 * LSC_NX + x1) * 4 + p4];
    return clamp(mix(mix(g00, g10, wx), mix(g01, g11, wx), wy), 0.5, 4.0);
}

// Bad pixel: a site further than `dpcThreshold` from the median of its 3x3
// neighbourhood is replaced by that median. Reads the raw plane, so it runs
// BEFORE the footprint sum — the only place a hot pixel can be removed without
// having already smeared it into the average.
float dpcRaw(int rx, int ry, int sw, int sh) {
    float c = in_data[ry * sw + rx];
    // `stages` is the buffer; `main()` shadows it with the mask it read.
    if ((int(stages[0]) & ST_DPC) == 0) return c;
    float n[8];
    int k = 0;
    for (int dy = -1; dy <= 1; ++dy) {
        for (int dx = -1; dx <= 1; ++dx) {
            if (dx == 0 && dy == 0) continue;
            int sx = clamp(rx + dx, 0, sw - 1);
            int sy = clamp(ry + dy, 0, sh - 1);
            n[k++] = in_data[sy * sw + sx];
        }
    }
    // median of 8 = average of the two middle order statistics
    for (int i = 0; i < 8; ++i)
        for (int j = i + 1; j < 8; ++j)
            if (n[j] < n[i]) { float t = n[i]; n[i] = n[j]; n[j] = t; }
    float med = 0.5 * (n[3] + n[4]);
    return (abs(c - med) > dpcThreshold[0]) ? med : c;
}

// Luma-preserving saturation — the same form isp.saturation applies to planar RGB.
float satLuma(float r, float g, float b) {
    return 0.299 * r + 0.587 * g + 0.114 * b;
}

// Publishes the 64x64 output snapshot. Called on EVERY exit path, so an op that
// ran and wrote nothing is distinguishable from one that never ran (all-zero).
void debug_publish() {
    if (gl_GlobalInvocationID.x != 0u || gl_GlobalInvocationID.y != 0u) return;
    int dw = int(hw[H_OUT_W]);
    int dh = int(hw[H_OUT_H]);
    if (dw < 1) dw = 1;
    if (dh < 1) dh = 1;
    float planeF = (cfg.length() > 1u) ? cfg[1] : 3.0;
    int planes = int(planeF);
    if (planes < 1) planes = 1;
    int outN = planes * dw * dh;
    dbg[0] = float(DBG_SCHEMA);
    dbg[1] = float(outN);
    dbg[2] = float(dw);
    dbg[3] = float(dh);
    dbg[4] = float(planes);
    for (int dy = 0; dy < DBG_H; ++dy) {
        int sy = (dy * dh) / DBG_H;
        for (int dx = 0; dx < DBG_W; ++dx) {
            int sx = (dx * dw) / DBG_W;
            int i = sy * dw + sx;
            if (i < 0 || i >= outN) i = 0;
            dbg[DBG_OFF + dy * DBG_W + dx] = out_data[i];
        }
    }
}

void main() {    // ── CONFIG: BYPASS (binding 2) ──────────────────────────────────────────
    // cfg[0] >= 0.5 short-circuits the WHOLE fused chain: the raw source plane is
    // mapped straight into the three display planes and no stage runs. This is
    // the "essentially identity from input to output" case, and it is also the
    // cheapest proof that the op is wired correctly at all.
    if (cfg.length() > 0u && cfg[0] >= 0.5) {
        int ow0 = int(hw[H_OUT_W]);
        int oh0 = int(hw[H_OUT_H]);
        int sw0 = int(hw[H_SRC_W]);
        int sh0 = int(hw[H_SRC_H]);
        uint bx = gl_GlobalInvocationID.x;
        uint by = gl_GlobalInvocationID.y;
        if (ow0 > 0 && oh0 > 0 && sw0 > 0 && sh0 > 0 && int(bx) < ow0 && int(by) < oh0) {
            // Nearest-neighbour mapping of the source plane, so the output is a
            // real image rather than a flat fill.
            int sx = (int(bx) * sw0) / ow0;
            int sy = (int(by) * sh0) / oh0;
            int sidx = sy * sw0 + sx;
            if (sidx < 0 || sidx >= sw0 * sh0) sidx = 0;
            int oplane = ow0 * oh0;
            int oidx = int(by) * ow0 + int(bx);
            out_data[oidx]              = in_data[sidx];
            out_data[oplane + oidx]     = in_data[sidx];
            out_data[2 * oplane + oidx] = in_data[sidx];
        }
        debug_publish();
        return;
    }

    // ── NORMAL PATH ────────────────────────────────────────────────────

        uint xo = gl_GlobalInvocationID.x;
        uint yo = gl_GlobalInvocationID.y;

        int ow = int(hw[H_OUT_W]);
        int oh = int(hw[H_OUT_H]);
        if (ow < 1 || oh < 1) return;
        if (int(xo) >= ow || int(yo) >= oh) return;

        int sw = int(hw[H_SRC_W]);       // raw plane stride width
        int sh = int(hw[H_SRC_H]);
        if (sw < 2 || sh < 2) return;

        // Crop window (mirrors PipelineConfigurator's resolvedCrop); start 0.
        int cropW = ALIGN16(sw);
        if (cropW <= 0 || cropW > sw) cropW = sw;
        int cropH = sh;
        int startW = 0;
        int startH = 0;
        if (cropW < 2 || cropH < 2) return;

        int x = int(xo);
        int y = int(yo);

        // Stage mask. Unfed (0) means FULL — see ST_ALL. Read BEFORE the geometry
        // because LETTERBOX decides whether the fit/centre step runs at all.
        int stages = int(stages[0]);
        if (stages == 0) stages = ST_ALL;

        // ── 1:1 CENTRE CROP (the DOWNSCALE stage, inverted) ──
        // With ST_NOSCALE set the op resamples NOTHING: it takes the centre
        // outW x outH window of the source and maps it 1:1. Any remaining defect is
        // then provably not the resampling. Falls through to the scaled mapping
        // when the source is smaller than the output (nothing to crop).
        bool oneToOne = ((stages & ST_NOSCALE) != 0) && cropW >= ow && cropH >= oh;
        int cropX0 = oneToOne ? (cropW - ow) / 2 : 0;
        int cropY0 = oneToOne ? (cropH - oh) / 2 : 0;

        // ── FIT + LETTERBOX (identical geometry to isp.downscale) ──
        // With LETTERBOX off the content fills the output grid: useful when the
        // black bars themselves are suspected of confusing the readback.
        int cw, ch, offX, offY;
        if (oneToOne) {
            cw = ow; ch = oh; offX = 0; offY = 0;
        } else if ((stages & ST_LETTERBOX) != 0) {
            float fitW = float(ow) / float(cropW);
            float fitH = float(oh) / float(cropH);
            float scale = min(fitW, fitH);
            cw = max(int(float(cropW) * scale + 0.5), 1);   // content W
            ch = max(int(float(cropH) * scale + 0.5), 1);   // content H
            offX = (ow - cw) / 2;
            offY = (oh - ch) / 2;
        } else {
            cw = ow; ch = oh; offX = 0; offY = 0;
        }

        int cx = x - offX;
        int cy = y - offY;
        int oplane = ow * oh;
        int oidx = y * ow + x;

        // Outside the content rect -> black letterbox / pillarbox.
        if (cx < 0 || cy < 0 || cx >= cw || cy >= ch) {
            out_data[oidx] = 0.0;
            out_data[oplane + oidx] = 0.0;
            out_data[2 * oplane + oidx] = 0.0;
            return;
        }

        // ── AREA FOOTPRINT in crop-local coordinates ──
        // Output pixel [cx,cx+1) x [cy,cy+1) maps to this exact source rectangle:
        // the area filter weights every source sample by how much of it the output
        // pixel actually covers. The OLD 2-tap bilinear could not represent this
        // footprint, which is what aliased chroma back into the image.
        float sx0, sx1, sy0, sy1;
        if (oneToOne) {
            sx0 = float(cropX0 + cx);     sx1 = sx0 + 1.0;
            sy0 = float(cropY0 + cy);     sy1 = sy0 + 1.0;
        } else {
            sx0 = float(cx)     * float(cropW) / float(cw);
            sx1 = float(cx + 1) * float(cropW) / float(cw);
            sy0 = float(cy)     * float(cropH) / float(ch);
            sy1 = float(cy + 1) * float(cropH) / float(ch);
        }

        int ix0 = int(floor(sx0));
        int ix1 = int(ceil(sx1));
        int iy0 = int(floor(sy0));
        int iy1 = int(ceil(sy1));

        int pat = int(bayerPattern[0]);
        if (pat < 0) pat = 0;
        if (pat > 3) pat = 3;

        // Raw-domain divisor. The uploaded plane is raw sensor units; every
        // coefficient below is normalized, so this is the stage that makes them
        // commensurate. 1.0 fallback keeps a legacy caller working.
        float invSensorMax = 1.0 / max(sensorMax[0], 1e-6);

        float accR = 0.0, accG = 0.0, accB = 0.0;
        // One weight sum per CHANNEL, not one for the footprint.
        //
        // A 2x2 RGGB footprint holds one red site, two green and one blue. Dividing
        // every channel by the total weight (4) gives R/4, 2G/4 and B/4 — so red
        // and blue come out four times too dark and green twice, which is both a
        // uniform darkening and a green cast. Each channel has to be normalised by
        // the weight it actually collected.
        float wsumR = 0.0, wsumG = 0.0, wsumB = 0.0;

        for (int iy = iy0; iy < iy1; iy++) {
            // Overlap of this source row with the footprint on the y axis.
            float wy = min(sy1, float(iy + 1)) - max(sy0, float(iy));
            if (wy <= 0.0) continue;
            int ry = startH + iy;
            if (ry < 0 || ry >= sh) continue;

            for (int ix = ix0; ix < ix1; ix++) {
                float wx = min(sx1, float(ix + 1)) - max(sx0, float(ix));
                if (wx <= 0.0) continue;
                int rx = startW + ix;
                if (rx < 0 || rx >= sw) continue;

                float w = wx * wy;
                int par   = ((ry & 1) << 1) | (rx & 1);
                int plane = planeForColor(par, pat);
                int chn   = chanOfPlane(plane);
                // DEMOSAIC off -> the footprint becomes a point sample of the
                // nearest source pixel, which isolates whether the AREA AVERAGING
                // is what spreads colour. With it on, every sample in the footprint
                // contributes its area weight.
                // 1:1 has a 1x1 footprint, so the mask cannot change the result; the
                // DEMOSAIC bit then only decides whether the area weight is used.
                if ((stages & ST_DEMOSAIC) == 0 && !(ix == ix0 && iy == iy0)) continue;

                float v = dpcRaw(rx, ry, sw, sh);
                if ((stages & ST_NORMALIZE) != 0) v *= invSensorMax;
                if ((stages & ST_BLC) != 0)       v -= blcOf(plane);
                if ((stages & ST_LSC) != 0)       v *= lscOf(plane, rx, ry, sw, sh);
                if ((stages & ST_WB) != 0)        v *= wbOf(plane);

                if (chn == 0)      { accR += v * w; wsumR += w; }
                else if (chn == 1) { accG += v * w; wsumG += w; }
                else               { accB += v * w; wsumB += w; }
            }
        }

        if (wsumR + wsumG + wsumB <= 0.0) {
            out_data[oidx] = 0.0;
            out_data[oplane + oidx] = 0.0;
            out_data[2 * oplane + oidx] = 0.0;
            return;
        }
        // Normalise each channel by its own coverage. A footprint that caught no
        // site of one colour leaves that channel at 0 rather than dividing by zero.
        float r = (wsumR > 0.0) ? accR / wsumR : 0.0;
        float g = (wsumG > 0.0) ? accG / wsumG : 0.0;
        float b = (wsumB > 0.0) ? accB / wsumB : 0.0;

        // ── CCM (row-major 3x3, the SAME CCMBLOCK/CCM_MATRIX CcmBlock reads) ──
        float cr = r, cg = g, cb = b;
        if ((stages & ST_CCM) != 0) {
            cr = ccmMatrix[0] * r + ccmMatrix[1] * g + ccmMatrix[2] * b;
            cg = ccmMatrix[3] * r + ccmMatrix[4] * g + ccmMatrix[5] * b;
            cb = ccmMatrix[6] * r + ccmMatrix[7] * g + ccmMatrix[8] * b;
        }

        // ── S-curve shadow lift (same form as isp_gamma's binding 4) ──
        float lift = ((stages & ST_LIFT) != 0) ? shadowLift[0] : 0.0;
        if (lift != 0.0) {
            cr = cr + lift * (1.0 - cr) * (1.0 - cr);
            cg = cg + lift * (1.0 - cg) * (1.0 - cg);
            cb = cb + lift * (1.0 - cb) * (1.0 - cb);
        }

        // ── Gamma encode ──
        // TONE_CURVE/GAMMA_RECIP is 1/display_gamma (the encoded exponent is its
        // reciprocal), exactly as isp.gamma consumes the same tensor.
        float recip = max(gammaRecip[0], 1e-4);
        float gam = 1.0 / recip;
        float invg = recip;                       // pow(v, 1/gam) == pow(v, recip)
        if ((stages & ST_GAMMA) != 0 && gam > 0.0001) {
            cr = pow(clamp(cr, 0.0, 1.0), invg);
            cg = pow(clamp(cg, 0.0, 1.0), invg);
            cb = pow(clamp(cb, 0.0, 1.0), invg);
        } else {
            cr = clamp(cr, 0.0, 1.0);
            cg = clamp(cg, 0.0, 1.0);
            cb = clamp(cb, 0.0, 1.0);
        }

        // ── Saturation (luma-preserving) ──
        // isp.saturation's contract is a scale about luma, applied after the
        // colour matrix and before the display encode — exactly here.
        if ((stages & ST_SATURATION) != 0) {
            float sat = saturation[0];
            float l = satLuma(cr, cg, cb);
            cr = l + (cr - l) * sat;
            cg = l + (cg - l) * sat;
            cb = l + (cb - l) * sat;
        }

        // Output scale. By here the value is already in [0,1] — normalize divided
        // by the white level and gamma mapped the rest — so ST_LEVELS is just a
        // choice between emitting that and the original 0-255 display domain
        // softisp's planar consumers (probe means, the AHB preview's own x255)
        // assume.
        float outScale = ((stages & ST_LEVELS) != 0) ? 1.0 : 255.0;
        out_data[oidx]              = cr * outScale;
        out_data[oplane + oidx]     = cg * outScale;
        out_data[2 * oplane + oidx] = cb * outScale;

    debug_publish();
}
