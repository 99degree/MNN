#version 450
// isp.ldci — local dynamic contrast improvement.
//
// Replaces a placeholder that copied its input, which silently deleted the
// stage. The block's primitive form is AveragePool(3x3, pad 1) -> Sub -> Mul ->
// Add, i.e. `out = in + strength * (in - local_mean)`; this shader does the
// same maths in one dispatch.
//
// Inputs (universal isp.* map):
//   binding 3 = frame      [1,3,H,W] planar RGB in [0,1]
//   binding 5 = StrengthBuf [1]
// Output:
//   binding 4 = frame      [1,3,H,W] planar RGB
//
// The 3x3 average replicates the edge pixel rather than padding with zeros, so
// the frame does not gain a dark rim.

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) buffer Uniforms {
    float width;
    float height;
    float pad0;
    float pad1;
} u;

layout(set = 0, binding = 3) readonly  buffer InBuf    { float in_data[]; };
layout(set = 0, binding = 4) writeonly buffer OutBuf   { float out_data[]; };
layout(set = 0, binding = 5) readonly  buffer Strength { float strength[]; };

void main() {
    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;
    int w = int(u.width);
    int h = int(u.height);
    if (int(x) >= w || int(y) >= h) return;

    int plane = w * h;
    int p = int(y) * w + int(x);
    float s = strength[0];

    for (int c = 0; c < 3; ++c) {
        int base = c * plane;
        float local = 0.0;
        for (int ky = -1; ky <= 1; ++ky) {
            int sy = int(y) + ky;
            if (sy < 0) sy = 0;
            if (sy >= h) sy = h - 1;
            for (int kx = -1; kx <= 1; ++kx) {
                int sx = int(x) + kx;
                if (sx < 0) sx = 0;
                if (sx >= w) sx = w - 1;
                local += in_data[base + sy * w + sx];
            }
        }
        local /= 9.0;
        float v = in_data[base + p];
        out_data[base + p] = clamp(v + s * (v - local), 0.0, 1.0);
    }
}
