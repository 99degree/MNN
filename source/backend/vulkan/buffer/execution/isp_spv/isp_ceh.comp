#version 450
// isp.ceh — placeholder compute shader
// Uniforms: {W, H, params...}
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;
layout(set = 0, binding = 0, std430) buffer Uniforms {
    float width; float height; float param1; float param2; float param3; float param4;
} u;
layout(set = 0, binding = 1) readonly  buffer InBuf  { float in_data[]; };
layout(set = 0, binding = 2) writeonly buffer OutBuf { float out_data[]; };

void main() {
    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;
    int w = int(u.width);
    int h = int(u.height);
    if (int(x) >= w || int(y) >= h) return;
    int idx = (int(y) * w + int(x));
    // PLANAR [1,3,H,W]: copy ALL planes. `out_data[idx] = in_data[idx]` with
    // idx = y*w+x copied PLANE 0 only and left G/B unwritten.
    int plane = w * h;
    int p = int(y) * w + int(x);
    out_data[0 * plane + p] = in_data[0 * plane + p];
    out_data[1 * plane + p] = in_data[1 * plane + p];
    out_data[2 * plane + p] = in_data[2 * plane + p];
}
