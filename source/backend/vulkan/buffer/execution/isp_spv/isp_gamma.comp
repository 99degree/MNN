#version 450
// isp.gamma — Gamma correction: out = pow(in, 1/gamma)
// Uniforms: {W, H, gamma}
// In: float[NCHW] image
// Out: float[NCHW]

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) buffer Uniforms {
    float width;
    float height;
    float inv_gamma;
} u;

layout(set = 0, binding = 1) readonly  buffer InBuf  { float in_data[]; };
layout(set = 0, binding = 2) writeonly buffer OutBuf { float out_data[]; };

void main() {
    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;
    uint w = uint(u.width);
    uint h = uint(u.height);
    if (x >= w || y >= h) return;

    uint plane = w * h;
    uint idx = y * w + x;
    float v = in_data[idx];

    // pow(x, 1/gamma) via log/exp for Vulkan 1.0 (no pow in GLSL ES? No — GLSL 450 has pow()!)
    v = clamp(v, 0.0, 1e10);
    v = v + 1e-9;
    v = exp(log(v) * u.inv_gamma);

    out_data[idx] = v;
}