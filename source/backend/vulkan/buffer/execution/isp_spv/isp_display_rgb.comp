#version 450
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;
layout(set = 0, binding = 0, std430) buffer Uniforms {
    float width; float height; float gamma; float pad;
} u;
layout(set = 0, binding = 1) readonly  buffer InBuf  { float in_data[]; };
layout(set = 0, binding = 2) writeonly buffer OutBuf { float out_data[]; };

void main() {
    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;
    int w = int(u.width);
    int h = int(u.height);
    if (int(x) >= w || int(y) >= h) return;
    int idx = (int(y) * w + int(x)) * 3;
    float r = in_data[idx + 0];
    float g = in_data[idx + 1];
    float b = in_data[idx + 2];
    float invGamma = 1.0 / u.gamma;
    out_data[idx + 0] = pow(max(r, 0.0), invGamma);
    out_data[idx + 1] = pow(max(g, 0.0), invGamma);
    out_data[idx + 2] = pow(max(b, 0.0), invGamma);
}
