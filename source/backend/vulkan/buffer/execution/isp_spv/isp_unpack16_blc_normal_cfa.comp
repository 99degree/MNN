#version 450
// isp.unpack16_blc_normal_cfa — normalize + BLC + quad unpack from INT16 RAW in one dispatch.
// Input:  [1,1,H,W] INT16 raw Bayer plane (full-res, one sample per pixel, sensor counts).
// Output: [1,4,H/2,W/2] NCHW float PLANAR quad: plane p holds channel p of
//         every quad — [TL, TR, BL, BR] = [R, G1, G2, B] for RGGB.
//
// Replaces the host-side INT16→FLOAT32 conversion + unpack split + normalize + BLC + CFA
// by doing it all on GPU. The host passes the raw INT16 buffer directly; the shader
// converts INT16→FLOAT32, divides by sensor_max, subtracts BLC, and unpacks the 2x2 Bayer sites.
//
// Bindings:
//   binding 0 = Uniforms {width, height, sensor_max, gain, blc_offsets[4], bayer_pattern}
//   binding 1 = input INT16 plane (readonly)
//   binding 2 = output float quad planes (writeonly)

#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) buffer Uniforms {
    float width;        // source (full-res) W
    float height;       // source (full-res) H
    float sensor_max;   // sensor white level (e.g., 1023.0 or 65535.0)
    float gain;         // post-BLC gain (typically 1.0)
    float blc_r;        // BLC offsets in sensor counts (0..sensor_max)
    float blc_gr;
    float blc_gb;
    float blc_b;
    int   bayer_pattern; // 0=RGGB, 1=GRBG, 2=GBRG, 3=BGGR
} u;

layout(set = 0, binding = 1) readonly  buffer InBuf  { int16_t in_data[]; };
layout(set = 0, binding = 2) writeonly buffer OutBuf { float out_data[]; };

void main() {
    uint x = gl_GlobalInvocationID.x;   // quad column
    uint y = gl_GlobalInvocationID.y;   // quad row
    int srcW = int(u.width);
    int srcH = int(u.height);
    int qw = srcW / 2;
    int qh = srcH / 2;
    if (int(x) >= qw || int(y) >= qh) return;

    int inX = int(x) * 2;
    int inY = int(y) * 2;
    int base = inY * srcW + inX;
    int idx  = int(y) * qw + int(x);       // quad index
    uint plane = uint(qw) * uint(qh);      // plane stride

    // Read 2x2 Bayer sites from INT16 raw plane
    int16_t tl_i16 = in_data[base];              // TL
    int16_t tr_i16 = in_data[base + 1];          // TR
    int16_t bl_i16 = in_data[base + srcW];       // BL
    int16_t br_i16 = in_data[base + srcW + 1];   // BR

    // Convert INT16→FLOAT32 and normalize
    float smax = max(u.sensor_max, 1.0);
    float tl = float(tl_i16) / smax;
    float tr = float(tr_i16) / smax;
    float bl = float(bl_i16) / smax;
    float br = float(br_i16) / smax;

    // BLC offsets in [0, 1] (normalized by sensor_max)
    float blc0 = u.blc_r  / smax;
    float blc1 = u.blc_gr / smax;
    float blc2 = u.blc_gb / smax;
    float blc3 = u.blc_b  / smax;

    // Bayer phase determines colour -> plane mapping
    // RGGB (0): plane0=R(TL), plane1=G1(TR), plane2=G2(BL), plane3=B(BR)
    // GRBG (1): plane0=G1(TL), plane1=R(TR), plane2=B(BL), plane3=G2(BR)
    // GBRG (2): plane0=G2(TL), plane1=B(TR), plane2=R(BL), plane3=G1(BR)
    // BGGR (3): plane0=B(TL), plane1=G2(TR), plane2=G1(BL), plane3=R(BR)

    int p = u.bayer_pattern;
    float r, g1, g2, b;

    if (p == 0) { // RGGB
        r = tl; g1 = tr; g2 = bl; b = br;
    } else if (p == 1) { // GRBG
        g1 = tl; r = tr; b = bl; g2 = br;
    } else if (p == 2) { // GBRG
        g2 = tl; b = tr; r = bl; g1 = br;
    } else { // BGGR (3)
        b = tl; g2 = tr; g1 = bl; r = br;
    }

    // Apply BLC and gain, clamp to >= 0
    float gain = u.gain;
    r  = max(r  - blc0, 0.0) * gain;
    g1 = max(g1 - blc1, 0.0) * gain;
    g2 = max(g2 - blc2, 0.0) * gain;
    b  = max(b  - blc3, 0.0) * gain;

    // Write to planar quad output
    out_data[idx]               = r;
    out_data[plane + idx]       = g1;
    out_data[plane * 2u + idx]  = g2;
    out_data[plane * 3u + idx]  = b;
}
