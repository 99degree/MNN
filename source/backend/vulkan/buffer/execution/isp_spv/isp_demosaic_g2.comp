#version 450
// isp.demosaic_g2 — G2-average demosaic on GPU.
//
// Input:  float[1,4,H,W] NCHW PLANAR quad channels [TL,TR,BL,BR] from CfaBlock.
// Output: float[1,3,H,W] NCHW PLANAR RGB planes.
//
// Bindings follow the universal isp.* positional map:
//   binding 0 = {W,H,pad,pad} (zeroed const attr, hotSwap W/H at first encode)
//   binding 1 = input frame  [1,4,H,W]  (4 quad planes)
//   binding 2 = output frame [1,3,H,W]  (3 RGB planes)
//   binding 3 = DEMOSAIC_G2_HW float[4]  {W,H,pad,pad}  runtime HW input tensor
//   binding 4 = DEMOSAIC_BAYER_PATTERN float[1]  0=RGGB,1=GRBG,2=GBRG,3=BGGR
//
// G2-average: R from its own quad site, G=(two green sites averaged), B from its own site.
//   RGGB (0):  R=TL, G=(TR+BL)/2, B=BR
//   GRBG (1):  R=TR, G=(TL+BR)/2, B=BL
//   GBRG (2):  R=BL, G=(TL+BR)/2, B=TR
//   BGGR (3):  R=BR, G=(TR+TL)/2, B=TL
//
// LAYOUT CONTRACT (2026-10-16): planar NCHW throughout. Matches isp.ccm,
// isp.downscale, isp.gamma planar layout.

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) buffer Uniforms {
    float width;
    float height;
    float pad0;
    float pad1;
} u;

layout(set = 0, binding = 1) readonly  buffer InBuf  { float in_data[]; };
layout(set = 0, binding = 2) writeonly buffer OutBuf { float out_data[]; };
layout(set = 0, binding = 3) readonly  buffer DemosaicHwBuf { float demosaicHw[]; };
layout(set = 0, binding = 4) readonly  buffer BayerPatternBuf { float bayerPattern[]; };

void main() {
    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;
    int w = int(u.width);
    int h = int(u.height);
    if (int(x) >= w || int(y) >= h) return;

    int plane = w * h;           // per-plane stride
    int idx = int(y) * w + int(x);

    // Read runtime HW (should match u.width/u.height, but use binding 3 as
    // authoritative so the controller can resize per frame).
    int rw = int(demosaicHw[0]);
    int rh = int(demosaicHw[1]);
    if (rw > 0) w = rw;
    if (rh > 0) h = rh;
    plane = w * h;
    idx = int(y) * w + int(x);
    if (int(x) >= w || int(y) >= h) return;

    // Bayer pattern: 0=RGGB, 1=GRBG, 2=GBRG, 3=BGGR
    int pat = int(bayerPattern[0]);
    if (pat < 0) pat = 0;
    if (pat > 3) pat = 3;

    // inCh 0=TL,1=TR,2=BL,3=BR
    float t0 = in_data[0 * plane + idx];
    float t1 = in_data[1 * plane + idx];
    float t2 = in_data[2 * plane + idx];
    float t3 = in_data[3 * plane + idx];

    float r, g, b;
    if (pat == 0) {          // RGGB: TL=R, TR=Gr, BL=Gb, BR=B
        r = t0;
        g = (t1 + t2) * 0.5;
        b = t3;
    } else if (pat == 1) {   // GRBG: TL=Gr, TR=R, BL=B, BR=Gb
        r = t1;
        g = (t0 + t3) * 0.5;
        b = t2;
    } else if (pat == 2) {   // GBRG: TL=Gb, TR=B, BL=R, BR=Gr
        r = t2;
        g = (t0 + t3) * 0.5;
        b = t1;
    } else {                 // BGGR: TL=B, TR=Gb, BL=Gr, BR=R
        r = t3;
        g = (t1 + t2) * 0.5;
        b = t0;
    }

    out_data[0 * plane + idx] = r;
    out_data[1 * plane + idx] = g;
    out_data[2 * plane + idx] = b;
}
