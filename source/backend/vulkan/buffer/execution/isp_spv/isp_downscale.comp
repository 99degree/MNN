#version 450
// isp.downscale — ARBITRARY-ratio resize, 3-channel planar NCHW.
//
// Uniforms (binding 0): {W, H, pad, pad} — W/H HOT-SWAPPED by the ELEMENTWISE
//   patch from the input tensor dims at first encode.
// Params (binding 3): DOWNSCALE_HW float[4] = {W, H, outW, outH} — the output
//   resolution rides in as a runtime per-frame input tensor, so the controller
//   can resize per frame instead of baking it at build time.
// In:  float[1,3,H,W] NCHW PLANAR image (R,G,B planes) — matches isp.ccm output.
// Out: float[1,3,outH,outW], same planar layout.
//
// [MATCH 2026-10-20] Matches the block's PRIMITIVE opset (ONNX Resize):
//   mode = LINEAR, coordinate_transformation_mode = ASYMMETRIC
//   asymmetric mapping: src = dst_index * (in_size / out_size), no half-pixel
//   shift. Bilinear between floor/ceil neighbors, edge-clamped.
//
// LAYOUT CONTRACT (2026-10-16): planar NCHW throughout the RGB chain.

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) buffer Uniforms {
    float width;
    float height;
    float pad0;
    float pad1;
} u;

layout(set = 0, binding = 1) readonly  buffer InBuf  { float in_data[]; };
layout(set = 0, binding = 2) writeonly buffer OutBuf { float out_data[]; };
layout(set = 0, binding = 3) readonly  buffer ParamBuf { float params[]; };

void main() {
    uint xo = gl_GlobalInvocationID.x;
    uint yo = gl_GlobalInvocationID.y;
    int w = int(u.width);    // source W
    int h = int(u.height);   // source H
    int ow = int(params[2]); // output W
    int oh = int(params[3]); // output H
    if (ow < 1 || oh < 1) return;
    if (int(xo) >= ow || int(yo) >= oh) return;

    int x = int(xo);
    int y = int(yo);

    // ONNX Resize ASYMMETRIC + LINEAR: src = dst * (in / out), no half-pixel.
    float sx = float(x) * float(w) / float(ow);
    float sy = float(y) * float(h) / float(oh);

    // Bilinear neighbors (edge-clamped to [0, in-1]).
    int x0 = int(floor(sx));
    int y0 = int(floor(sy));
    int x1 = min(x0 + 1, w - 1);
    int y1 = min(y0 + 1, h - 1);
    x0 = min(max(x0, 0), w - 1);
    y0 = min(max(y0, 0), h - 1);
    float fx = sx - float(x0);
    float fy = sy - float(y0);
    fx = clamp(fx, 0.0, 1.0);
    fy = clamp(fy, 0.0, 1.0);

    int iplane = w * h;
    int oplane = ow * oh;
    int oidx = y * ow + x;

    for (int c = 0; c < 3; c++) {
        int base = c * iplane;
        float p00 = in_data[base + y0 * w + x0];
        float p01 = in_data[base + y0 * w + x1];
        float p10 = in_data[base + y1 * w + x0];
        float p11 = in_data[base + y1 * w + x1];
        float top = p00 + (p01 - p00) * fx;
        float bot = p10 + (p11 - p10) * fx;
        out_data[c * oplane + oidx] = top + (bot - top) * fy;
    }
}
