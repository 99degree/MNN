#version 450
// isp.downscale — 2x2 box downsample, 3-channel.
// Uniforms (binding 0): {W, H, outW, outH} — W/H hot-swapped by the
// ELEMENTWISE patch from the input tensor dims at first encode.
// In:  float[1,3,H,W] NCHW PLANAR image (R,G,B planes) — matches the
//      isp.ccm output layout.
// Out: float[1,3,H/2,W/2], same planar layout.
//
// LAYOUT CONTRACT (2026-10-16): planar NCHW throughout the RGB chain. The
// previous interleaved indexing ((y*w+x)*3) on planar data scrambled
// channels — the "snow" pattern.

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) buffer Uniforms {
    float width;
    float height;
    float outW;
    float outH;
} u;

layout(set = 0, binding = 1) readonly  buffer InBuf  { float in_data[]; };
layout(set = 0, binding = 2) writeonly buffer OutBuf { float out_data[]; };

void main() {
    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;
    int ow = int(u.outW);
    int oh = int(u.outH);
    if (int(x) >= ow || int(y) >= oh) return;
    int w = int(u.width);
    int inW = w;
    int inH = int(u.height);

    int iplane = inW * inH;
    int oplane = ow * oh;
    int oidx = int(y) * ow + int(x);
    int sx = int(x) * 2;
    int sy = int(y) * 2;
    int i00 = sy * inW + sx;
    int i01 = i00 + 1;
    int i10 = i00 + inW;
    int i11 = i10 + 1;

    out_data[oidx]           = (in_data[i00] + in_data[i01] + in_data[i10] + in_data[i11]) * 0.25;
    out_data[oplane + oidx]  = (in_data[iplane + i00] + in_data[iplane + i01] + in_data[iplane + i10] + in_data[iplane + i11]) * 0.25;
    out_data[2 * oplane + oidx] = (in_data[2 * iplane + i00] + in_data[2 * iplane + i01] + in_data[2 * iplane + i10] + in_data[2 * iplane + i11]) * 0.25;
}
