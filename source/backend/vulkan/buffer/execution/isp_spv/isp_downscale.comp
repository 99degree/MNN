#version 450
// isp.downscale — LINEAR FIT + LETTERBOX, 3-channel planar NCHW.
//
// USER SPEC (2026-10-20): linearly scale the frame down so that BOTH
// dimensions fit inside the output resolution (maintain the aspect ratio),
// CENTER the scaled content, and pad the leftover margins to the edges
// (pillarbox left/right, letterbox top/bottom) so the output is exactly
// outW x outH.
//
// Uniforms (binding 0): {W, H, pad, pad} — W/H HOT-SWAPPED by the ELEMENTWISE
//   patch from the input tensor dims at first encode.
// Params (binding 3): DOWNSCALE_HW float[4] = {W, H, outW, outH}.
// In:  float[1,3,H,W] NCHW PLANAR image (R,G,B planes).
// Out: float[1,3,outH,outW], same planar layout. Pad value = 0.0 (black).
//
// Sampling: ONNX-Resize-LINEAR-ASYMMETRIC-compatible bilinear within the
// fitted content rect (src = dst_content_index * (in / fitted_out)).

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) buffer Uniforms {
    float width;
    float height;
    float pad0;
    float pad1;
} u;

layout(set = 0, binding = 1) readonly  buffer InBuf  { float in_data[]; };
layout(set = 0, binding = 2) writeonly buffer OutBuf { float out_data[]; };
layout(set = 0, binding = 3) readonly  buffer ParamBuf { float params[]; };

void main() {
    uint xo = gl_GlobalInvocationID.x;
    uint yo = gl_GlobalInvocationID.y;
    int w = int(u.width);    // source W
    int h = int(u.height);   // source H
    int ow = int(params[2]); // output W
    int oh = int(params[3]); // output H
    if (ow < 1 || oh < 1) return;
    if (int(xo) >= ow || int(yo) >= oh) return;

    int x = int(xo);
    int y = int(yo);

    // FIT: scale = min(ow/w, oh/h) — both dimensions inside the output.
    float fitW = float(ow) / float(w);
    float fitH = float(oh) / float(h);
    float scale = min(fitW, fitH);
    int cw = max(int(float(w) * scale + 0.5), 1);   // content W
    int ch = max(int(float(h) * scale + 0.5), 1);   // content H
    // CENTER: margins to the edges (pillarbox / letterbox).
    int offX = (ow - cw) / 2;
    int offY = (oh - ch) / 2;

    // Outside the content rect → pad (black).
    int cx = x - offX;
    int cy = y - offY;
    if (cx < 0 || cy < 0 || cx >= cw || cy >= ch) {
        int oplane = ow * oh;
        int oidx = y * ow + x;
        out_data[oidx] = 0.0;
        out_data[oplane + oidx] = 0.0;
        out_data[2 * oplane + oidx] = 0.0;
        return;
    }

    // ONNX LINEAR+ASYMMETRY mapping within the content rect:
    // src = content_index * (in / content_out), no half-pixel shift.
    float sx = float(cx) * float(w) / float(cw);
    float sy = float(cy) * float(h) / float(ch);

    int x0 = int(floor(sx));
    int y0 = int(floor(sy));
    int x1 = min(x0 + 1, w - 1);
    int y1 = min(y0 + 1, h - 1);
    x0 = min(max(x0, 0), w - 1);
    y0 = min(max(y0, 0), h - 1);
    float fx = clamp(sx - float(x0), 0.0, 1.0);
    float fy = clamp(sy - float(y0), 0.0, 1.0);

    int iplane = w * h;
    int oplane = ow * oh;
    int oidx = y * ow + x;

    for (int c = 0; c < 3; c++) {
        int base = c * iplane;
        float p00 = in_data[base + y0 * w + x0];
        float p01 = in_data[base + y0 * w + x1];
        float p10 = in_data[base + y1 * w + x0];
        float p11 = in_data[base + y1 * w + x1];
        float top = p00 + (p01 - p00) * fx;
        float bot = p10 + (p11 - p10) * fx;
        out_data[c * oplane + oidx] = top + (bot - top) * fy;
    }
}
