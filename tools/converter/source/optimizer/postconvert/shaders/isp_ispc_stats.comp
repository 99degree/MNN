#version 450
// isp.ispc_stats — ReduceMean over spatial dims, per-channel
// Uniforms: {W, H, C}
// In:  float[C,H,W]  NCHW image (C channels, C ≤ 256, 256 % C == 0)
// Out: float[C] per-channel means
// 1 workgroup, 256 threads. Threads are grouped by channel: tid % C selects
// the channel, tid / C is the lane within that channel's group. Each group
// strides its own H*W plane, then tree-reduces within the group only.
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;
layout(set = 0, binding = 0, std430) buffer Uniforms { float width; float height; float channels; } u;
layout(set = 0, binding = 1) readonly  buffer InBuf  { float in_data[]; };
layout(set = 0, binding = 2) writeonly buffer OutBuf { float out_data[]; };

shared float partial[256];

void main() {
    uint tid = gl_LocalInvocationIndex.x;
    int w = int(u.width);
    int h = int(u.height);
    int c = int(u.channels);
    if (c < 1) c = 1;
    int plane = w * h;
    int myCh   = int(tid) % c;
    int lane   = int(tid) / c;
    int group  = 256 / c;              // threads per channel group
    if (group < 1) group = 1;
    int base = myCh * plane;
    float sum = 0.0;

    for (int idx = lane; idx < plane; idx += group) {
        sum += in_data[base + idx];
    }
    partial[tid] = sum;
    barrier();

    // Tree-reduce within the channel group only (never across channels).
    for (int step = group >> 1; step > 0; step >>= 1) {
        if ((int(tid) % group) < step) partial[tid] += partial[tid + step];
        barrier();
    }
    if (lane == 0) {
        out_data[myCh] = (plane > 0) ? partial[myCh * group] / float(plane) : 0.0;
    }
}
